---
import Layout from "../layouts/Layout.astro";
import { releaseData } from "../lib/data";

const releases = await releaseData();
---

<Layout title="Releases">
  <div class="container">
    <span class="eyebrow">GameBench seasons</span>
    <h1>Scores only compete under the same rules.</h1>
    <p class="lead">
      A new version can change games, tests, scoring, or required seeds. We keep
      every old ruleset available, but never mix its scores into a newer board.
    </p>

    <section class="section grid">
      {releases.map((release) => (
        <article class="card">
          <div class="section-head">
            <div>
              <span class="pill">{release.task_count} game challenges</span>
              <h2>
                <a href={`/releases/${release.benchmark_version}`}>
                  v{release.benchmark_version}
                </a>
              </h2>
            </div>
            <span class="mono muted">frozen rules</span>
          </div>
          <p>Contains {release.tasks.filter((task) => task.track === "build").length} make-new challenges and {release.tasks.filter((task) => task.track === "reproduce").length} recreation challenges.</p>
          <div class="actions"><a class="button" href={`/releases/${release.benchmark_version}`}>See what changed</a><a class="button secondary" href={`/benchmarks/${release.benchmark_version}/games`}>Play this version</a></div>
        </article>
      ))}
    </section>
  </div>
</Layout>
