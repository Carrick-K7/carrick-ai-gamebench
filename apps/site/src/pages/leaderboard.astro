---
import Layout from "../layouts/Layout.astro";
import RankingsPage from "../components/RankingsPage.astro";
import { releaseData, resultData } from "../lib/data";
import { latestResultBearingVersion } from "../lib/ranking";

const [releases, results] = await Promise.all([releaseData(), resultData()]);
const current = releases[0];
if (!current) throw new Error("no Benchmark release is available");
const selectedVersion = latestResultBearingVersion(releases, results.records) ?? current.benchmark_version;
---

<Layout
  title="Evaluation rankings"
  titleZh="评测排行"
  canonicalPath={`/benchmarks/${selectedVersion}/leaderboard`}
  description="Version-isolated Carrick AI GameBench machine-contract results."
>
  <RankingsPage version={selectedVersion} releases={releases} records={results.records} isShortcut />
</Layout>
