---
import Layout from "../../layouts/Layout.astro";
import {
  defaultOfficialSeed,
  releaseCatalogFor,
  resultData,
  type PlayableCandidate,
} from "../../lib/data";

export async function getStaticPaths() {
  const { records } = await resultData();
  const candidates: PlayableCandidate[] = records.flatMap((record) =>
    record.publication.runs.flatMap((run) => {
      const playable = run.artifacts.find(
        (artifact) => artifact.role === "playable",
      );
      if (!playable) {
        return [];
      }
      const showcaseName =
        `${run.task_id.replace(/[^a-zA-Z0-9._-]+/g, "-")}-showcase.png`;
      const showcase = run.artifacts.find(
        (artifact) =>
          artifact.role === "screenshot" &&
          artifact.file_name === showcaseName,
      );
      const source = run.artifacts.find(
        (artifact) => artifact.role === "clean-source",
      );
      const license = run.artifacts.find(
        (artifact) => artifact.role === "license",
      );
      return [{
        ...record,
        run,
        playable,
        ...(showcase ? { showcase } : {}),
        ...(source ? { source } : {}),
        ...(license ? { license } : {}),
      }];
    }),
  ).sort(
    (left, right) =>
      Number(right.entry.tier === "official") -
        Number(left.entry.tier === "official") ||
      Number(right.entry.status === "active") -
        Number(left.entry.status === "active") ||
      Number(left.run.seed !== defaultOfficialSeed) -
        Number(right.run.seed !== defaultOfficialSeed) ||
      left.entry.publication_id.localeCompare(
        right.entry.publication_id,
      ),
  );
  const byArtifact = new Map<string, PlayableCandidate[]>();
  for (const candidate of candidates) {
    const existing = byArtifact.get(candidate.playable.artifact_id) ?? [];
    existing.push(candidate);
    byArtifact.set(candidate.playable.artifact_id, existing);
  }
  return [...byArtifact.entries()].map(([artifactId, references]) => ({
    params: { id: artifactId.slice("sha256:".length) },
    props: { candidate: references[0]!, references },
  }));
}

const { candidate, references } = Astro.props as {
  candidate: PlayableCandidate;
  references: PlayableCandidate[];
};
const {
  entry,
  publication,
  run,
  playable,
  showcase,
  source,
  license,
} = candidate;
const catalog = await releaseCatalogFor(entry.benchmark_version);
const releasedTask = catalog?.tasks.find((task) => task.id === run.task_id);
const taskTitle = releasedTask?.source?.manifest.title.en ?? run.task_id;
---

<Layout title={`${entry.agent.model} · ${taskTitle}`}>
  <div class="container">
    <div class="output-meta">
      <span class={`pill ${entry.tier}`}>{entry.tier}</span>
      <span class="pill">{entry.status}</span>
      <span class="pill">seed {run.seed}</span>
    </div>
    <h1>
      <span class="lang-en">{taskTitle}</span>
      <span class="lang-zh">{releasedTask?.source?.manifest.title.zh ?? taskTitle}</span>
    </h1>
    <p class="lead">
      <span class="lang-en">
        Built from scratch by {entry.agent.model}. Play it first, then compare
        your experience with the browser score below.
      </span>
      <span class="lang-zh">
        由 {entry.agent.model} 从零制作。先亲自试玩，再将体验与下方浏览器分数比较。
      </span>
    </p>

    <section class="section">
      <div class="player-shell" data-player data-src={playable.url}>
        {showcase ? (
          <img
            class="player-cover"
            src={showcase.url}
            alt={`Deterministic showcase for ${run.task_id}`}
          />
        ) : (
          <div class="player-cover placeholder">
            Deterministic showcase cover was not published.
          </div>
        )}
        <div class="player-placeholder">
          <strong>Ready player?</strong>
          <span>
            This model-made game opens in a locked-down player with outside
            network access disabled.
          </span>
          <button class="button" type="button" data-load>Start game</button>
        </div>
      </div>
      <div class="actions compact">
        <button class="button secondary" type="button" data-reload>Reload</button>
        <button class="button secondary" type="button" data-fullscreen>Fullscreen</button>
        <a class="button secondary" href={playable.url} target="_blank" rel="noreferrer">
          Open isolated
        </a>
        {source && <a class="button secondary" href={source.url}>Clean source</a>}
        {license && <a class="button secondary" href={license.url}>License</a>}
      </div>
    </section>

    <div class="grid cols-4 section">
      <div class="card metric">
        <strong>{run.score ? run.score.percent.toFixed(1) : "—"}</strong>
        <span>browser test score</span>
      </div>
      <div class="card metric"><strong>{run.seed}</strong><span>fixed test seed</span></div>
      <div class="card metric"><strong>{run.exit_reason}</strong><span>run finished as</span></div>
      <div class="card metric">
        <strong>{run.verification ? "yes" : "no"}</strong>
        <span>independently verified</span>
      </div>
    </div>

    <section class="section prose">
      <h2>Want the receipts?</h2>
      <p>
        <a href={`/results/${entry.publication_id.slice(7)}`}>See every score and failure</a>
        {" "}·{" "}
        <a href={`/benchmarks/${entry.benchmark_version}/games/${run.task_id}`}>
          Compare this challenge across models
        </a>
      </p>
      <details class="audit">
        <summary>Immutable game and run IDs</summary>
        <div class="audit-body">
          <p><strong>Playable content</strong><br /><code>{playable.artifact_id}</code></p>
          <p><strong>Run</strong><br /><code>{run.run_id}</code></p>
          <p><strong>Publication</strong><br /><code>{publication.publication_id}</code></p>
          <p><strong>Publication references</strong><br />{references.length}</p>
        </div>
      </details>
    </section>
  </div>
</Layout>

<script>
  function loadPlayer(shell: HTMLElement): HTMLIFrameElement {
    const existing = shell.querySelector("iframe");
    if (existing instanceof HTMLIFrameElement) {
      return existing;
    }
    const iframe = document.createElement("iframe");
    iframe.className = "game";
    iframe.title = "Generated GameBench playable";
    iframe.src = shell.dataset.src ?? "";
    iframe.sandbox.add("allow-scripts", "allow-pointer-lock");
    iframe.referrerPolicy = "no-referrer";
    shell.replaceChildren(iframe);
    return iframe;
  }

  const shell = document.querySelector<HTMLElement>("[data-player]");
  document.querySelector("[data-load]")?.addEventListener("click", () => {
    if (shell) loadPlayer(shell);
  });
  document.querySelector("[data-reload]")?.addEventListener("click", () => {
    if (!shell) return;
    const iframe = loadPlayer(shell);
    iframe.src = iframe.src;
  });
  document.querySelector("[data-fullscreen]")?.addEventListener("click", () => {
    if (shell) void shell.requestFullscreen();
  });
</script>
