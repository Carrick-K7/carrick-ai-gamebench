---
import Layout from "../../layouts/Layout.astro";
import UiIcon from "../../components/UiIcon.astro";
import {
  defaultOfficialSeed,
  releaseCatalogFor,
  resultData,
  type PlayableCandidate,
} from "../../lib/data";
import { sampleIndexForRun, sampleLetter } from "../../lib/presentation";

export async function getStaticPaths() {
  const { records } = await resultData();
  const candidates: PlayableCandidate[] = records.flatMap((record) =>
    record.publication.runs.flatMap((run) => {
      const playable = run.artifacts.find(
        (artifact) => artifact.role === "playable",
      );
      if (!playable) {
        return [];
      }
      const showcaseName =
        `${run.task_id.replace(/[^a-zA-Z0-9._-]+/g, "-")}-showcase.png`;
      const showcase = run.artifacts.find(
        (artifact) =>
          artifact.role === "screenshot" &&
          artifact.file_name === showcaseName,
      );
      const source = run.artifacts.find(
        (artifact) => artifact.role === "clean-source",
      );
      const license = run.artifacts.find(
        (artifact) => artifact.role === "license",
      );
      return [{
        ...record,
        run,
        playable,
        ...(showcase ? { showcase } : {}),
        ...(source ? { source } : {}),
        ...(license ? { license } : {}),
      }];
    }),
  ).sort(
    (left, right) =>
      Number(right.entry.tier === "official") -
        Number(left.entry.tier === "official") ||
      Number(right.entry.status === "active") -
        Number(left.entry.status === "active") ||
      Number(left.run.seed !== defaultOfficialSeed) -
        Number(right.run.seed !== defaultOfficialSeed) ||
      left.entry.publication_id.localeCompare(
        right.entry.publication_id,
      ),
  );
  const byArtifact = new Map<string, PlayableCandidate[]>();
  for (const candidate of candidates) {
    const existing = byArtifact.get(candidate.playable.artifact_id) ?? [];
    existing.push(candidate);
    byArtifact.set(candidate.playable.artifact_id, existing);
  }
  return [...byArtifact.entries()].map(([artifactId, references]) => ({
    params: { id: artifactId.slice("sha256:".length) },
    props: { candidate: references[0]!, references },
  }));
}

const { candidate, references } = Astro.props as {
  candidate: PlayableCandidate;
  references: PlayableCandidate[];
};
const {
  entry,
  publication,
  run,
  playable,
  source,
  license,
} = candidate;
const catalog = await releaseCatalogFor(entry.benchmark_version);
const releasedTask = catalog?.tasks.find((task) => task.id === run.task_id);
const taskTitle = releasedTask?.source?.manifest.title.en ?? run.task_id;
const taskTitleZh = releasedTask?.source?.manifest.title.zh ?? taskTitle;
const taskRuns = publication.runs.filter(
  (candidateRun) => candidateRun.included && candidateRun.task_id === run.task_id,
);
const sampleIndex = sampleIndexForRun(taskRuns, run.run_id);
const sample = sampleLetter(Math.max(0, sampleIndex));
const isDefaultSample = run.seed === defaultOfficialSeed;
---

<Layout
  title={`${entry.agent.model} · ${taskTitle}`}
  titleZh={`${entry.agent.model} · ${taskTitleZh}`}
>
  <div class="container showcase-container">
    <div class="output-meta">
      <span class={`pill ${entry.tier}`}>{entry.tier}</span>
      <span class="pill">{entry.status}</span>
      <span class="pill">
        <span class="lang-en">Sample {sample}{isDefaultSample ? " · default showcase" : ""}</span>
        <span class="lang-zh">样本 {sample}{isDefaultSample ? " · 默认展示" : ""}</span>
      </span>
    </div>
    <h1>
      <span class="lang-en">{taskTitle}</span>
      <span class="lang-zh">{releasedTask?.source?.manifest.title.zh ?? taskTitle}</span>
    </h1>
    <p class="lead">
      <span class="lang-en">
        Built from scratch by {entry.agent.model}. Play it first, then compare
        your experience with the browser score below.
      </span>
      <span class="lang-zh">
        这是 {entry.agent.model} 从零做出的版本。先玩一遍，再看看下面的自动测试给了多少分。
      </span>
    </p>

    <section class="player-section">
      <div class="player-shell" data-player>
        <iframe
          class="game"
          src={playable.url}
          title="Carrick AI GameBench playable"
          data-title-en="Carrick AI GameBench playable"
          data-title-zh="Carrick AI GameBench 试玩游戏"
          sandbox="allow-scripts allow-pointer-lock"
          referrerpolicy="no-referrer"
          allowfullscreen
          loading="eager"
        ></iframe>
      </div>
      <div class="player-toolbar" aria-label="Game controls">
        <button class="button secondary" type="button" data-reload>
          <UiIcon name="reload" /><span class="lang-en">Reload</span><span class="lang-zh">重新加载</span>
        </button>
        <button class="button" type="button" data-fullscreen>
          <UiIcon name="fullscreen" /><span class="lang-en">Play fullscreen</span><span class="lang-zh">全屏游玩</span>
        </button>
        <details class="player-more">
          <summary class="button secondary">
            <UiIcon name="more" /><span class="lang-en">More</span><span class="lang-zh">更多</span>
          </summary>
          <div class="player-menu">
            <a href={playable.url} target="_blank" rel="noreferrer"><UiIcon name="external" /><span class="lang-en">Open isolated page</span><span class="lang-zh">在独立页面打开</span></a>
            {source && <a href={source.url}><UiIcon name="code" /><span class="lang-en">View clean source</span><span class="lang-zh">查看整理后的源码</span></a>}
            {license && <a href={license.url}><UiIcon name="file" /><span class="lang-en">View license</span><span class="lang-zh">查看许可证</span></a>}
          </div>
        </details>
      </div>
    </section>

    <div class="grid cols-3 section">
      <div class="card metric">
        <strong>{run.score ? run.score.percent.toFixed(1) : "—"}</strong>
        <span>browser test score</span>
      </div>
      <div class="card metric"><strong>{run.exit_reason}</strong><span>run finished as</span></div>
      <div class="card metric">
        <strong>{run.verification ? "yes" : "no"}</strong>
        <span>independently verified</span>
      </div>
    </div>

    <section class="section prose">
      <h2>Want the receipts?</h2>
      <p>
        <a href={`/results/${entry.publication_id.slice(7)}`}>See every score and failure</a>
        {" "}·{" "}
        <a href={`/benchmarks/${entry.benchmark_version}/games/${run.task_id}`}>
          Compare this challenge across models
        </a>
      </p>
      <details class="audit">
        <summary>Immutable game and run IDs</summary>
        <div class="audit-body">
          <p><strong>Playable content</strong><br /><code>{playable.artifact_id}</code></p>
          <p><strong>Run</strong><br /><code>{run.run_id}</code></p>
          <p><strong>Fixed random condition (seed)</strong><br /><code>{run.seed}</code></p>
          <p><strong>Publication</strong><br /><code>{publication.publication_id}</code></p>
          <p><strong>Publication references</strong><br />{references.length}</p>
        </div>
      </details>
    </section>
  </div>
</Layout>

<script>
  const shell = document.querySelector<HTMLElement>("[data-player]");
  document.querySelector("[data-reload]")?.addEventListener("click", () => {
    if (!shell) return;
    const iframe = shell.querySelector("iframe");
    if (!(iframe instanceof HTMLIFrameElement)) return;
    iframe.src = iframe.src;
  });
  document.querySelector("[data-fullscreen]")?.addEventListener("click", () => {
    if (shell) void shell.requestFullscreen().catch(() => undefined);
  });
</script>
