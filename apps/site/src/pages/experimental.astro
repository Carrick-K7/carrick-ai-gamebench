---
import Layout from "../layouts/Layout.astro";
import RankingsPage from "../components/RankingsPage.astro";
import { releaseData, resultData } from "../lib/data";

const [releases, results] = await Promise.all([releaseData(), resultData()]);
const current = releases[0];
if (!current) throw new Error("no Benchmark release is available");
---

<Layout title="Evaluation rankings" titleZh="评测排行" canonicalPath="/leaderboard" description="Playable, version-isolated Carrick AI GameBench model results.">
  <RankingsPage version={current.benchmark_version} releases={releases} records={results.records} />
</Layout>
