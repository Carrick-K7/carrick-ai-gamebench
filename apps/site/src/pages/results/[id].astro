---
import FlatBuildResultDetail from "../../components/FlatBuildResultDetail.astro";
import LegacyResultDetail from "../../components/LegacyResultDetail.astro";
import { isFlatBuildRecord, type SiteResultRecord } from "../../lib/data";

export async function getStaticPaths() {
  const { resultData } = await import("../../lib/data");
  const { records } = await resultData();
  return records.map((record) => ({
    // Both generations retain the exact existing canonical result URL.
    params: { id: record.entry.publication_id.slice("sha256:".length) },
    props: { record },
  }));
}

const { record } = Astro.props as { record: SiteResultRecord };
---

{isFlatBuildRecord(record)
  ? <FlatBuildResultDetail record={record} />
  : <LegacyResultDetail record={record} />}
