---
import Layout from "../../layouts/Layout.astro";
import {
  defaultOfficialSeed,
  releaseCatalogFor,
  score,
  type PublicationRecord,
} from "../../lib/data";

export async function getStaticPaths() {
  const { resultData } = await import("../../lib/data");
  const { records } = await resultData();
  return records.map((record) => ({
    params: { id: record.publication.publication_id.slice("sha256:".length) },
    props: { record },
  }));
}

const { record } = Astro.props as { record: PublicationRecord };
const { publication, entry } = record;
const catalog = await releaseCatalogFor(publication.benchmark.version);
const taskTitles = (taskId: string) => {
  const title = catalog?.tasks.find((task) => task.id === taskId)?.source?.manifest.title;
  return title ?? { en: taskId, zh: taskId };
};
const taskTitle = (taskId: string) => taskTitles(taskId).en;
const humanize = (value: string) => value
  .replace(/[-_.]+/g, " ")
  .replace(/\b\w/g, (letter) => letter.toUpperCase());
const included = publication.runs.filter((run) => run.included);
const verified = included.filter((run) => run.verification).length;
const failedTests = included.flatMap((run) =>
  (run.score?.tests ?? [])
    .filter((test) => !test.passed)
    .map((test) => ({ run, test })),
);
const categories = new Map<string, { earned: number; available: number }>();
for (const run of included) {
  for (const [name, category] of Object.entries(run.score?.categories ?? {})) {
    const current = categories.get(name) ?? { earned: 0, available: 0 };
    categories.set(name, {
      earned: current.earned + category.earned,
      available: current.available + category.available,
    });
  }
}
const imageDigests = [...new Set(
  included.flatMap((run) =>
    run.verification ? [run.verification.evaluator_image_digest] : [],
  ),
)];
const supersededBy = entry.superseded_by?.slice("sha256:".length);
---

<Layout title={`${publication.configuration.agent.model} result`}>
  <div class="container">
    {entry.status !== "active" && (
      <div class="callout status-banner">
        This publication is <strong>{entry.status}</strong>.
        {supersededBy && (
          <> Use the <a href={`/results/${supersededBy}`}>replacement publication</a> for discovery.</>
        )}
        The immutable historical record remains available.
      </div>
    )}

    <div class="output-meta">
      <span class={`pill ${publication.tier}`}>{publication.tier}</span>
      <span class="pill">{entry.status}</span>
      <span class="pill">
        {verified}/{included.length} runs verified
      </span>
    </div>
    <h1>{publication.configuration.agent.model}</h1>
    <p class="lead">
      <span class="lang-en">
        One model run, {publication.aggregate.tasks.length} game challenges.
        Open any game below, compare the experience with its score, or inspect
        the clean source. Tested with {publication.configuration.agent.id} on
        GameBench {publication.benchmark.version}.
      </span>
      <span class="lang-zh">
        这次一共测试了 {publication.aggregate.tasks.length} 个游戏任务。你可以直接试玩、对照分数，也可以查看整理后的源码。
        本次使用 {publication.configuration.agent.id}，基准版本为 GameBench {publication.benchmark.version}。
      </span>
    </p>

    <div class="grid cols-4 section">
      <div class="card metric">
        <strong>{score(publication.aggregate.leaderboards.core)}</strong>
        <span>Core · Build and Reproduce combined</span>
      </div>
      <div class="card metric">
        <strong>{score(publication.aggregate.leaderboards.build)}</strong>
        <span>Build · new games</span>
      </div>
      <div class="card metric">
        <strong>{score(publication.aggregate.leaderboards.reproduce)}</strong>
        <span>Reproduce · remade games</span>
      </div>
      <div class="card metric">
        <strong>{publication.aggregate.coverage.core.completed}/{publication.aggregate.coverage.core.required}</strong>
        <span>games completed</span>
      </div>
    </div>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">What the model made</span>
          <h2>Do not just read the score. Play it.</h2>
        </div>
        <p>
          The fixed presentation run appears first. We do not select the
          prettiest screenshot or highest-scoring attempt.
        </p>
      </div>
      <div class="grid cols-3">
        {publication.aggregate.tasks.map((task) => {
          const runs = included
            .filter((run) => run.task_id === task.task_id)
            .sort(
              (left, right) =>
                Number(left.seed !== defaultOfficialSeed) -
                  Number(right.seed !== defaultOfficialSeed) ||
                left.seed - right.seed,
            );
          const primaryRun = runs[0];
          const primaryPlayable = primaryRun?.artifacts.find(
            (artifact) => artifact.role === "playable",
          );
          const showcaseName =
            `${task.task_id.replace(/[^a-zA-Z0-9._-]+/g, "-")}-showcase.png`;
          const primaryShowcase = primaryRun?.artifacts.find(
            (artifact) =>
              artifact.role === "screenshot" && artifact.file_name === showcaseName,
          );
          return (
            <article class="card output-card">
              {primaryShowcase ? (
                <img class="cover" src={primaryShowcase.url} alt={`${taskTitle(task.task_id)} generated by ${publication.configuration.agent.model}`} loading="lazy" />
              ) : (
                <div class="cover placeholder">No playable cover was produced</div>
              )}
              <div class="output-meta">
                <span class="pill">{task.track === "build" ? "made new" : "recreated"}</span>
                <span class="pill">score {task.mean.toFixed(0)}</span>
              </div>
              <h3>
                <a href={`/benchmarks/${publication.benchmark.version}/games/${task.task_id}`}>
                  <span class="lang-en">{taskTitles(task.task_id).en}</span>
                  <span class="lang-zh">{taskTitles(task.task_id).zh}</span>
                </a>
              </h3>
              <p>{runs.length} scored run{runs.length === 1 ? "" : "s"}. Open the game, source, or exact test record below.</p>
              {primaryPlayable && (
                <a class="button" href={`/showcase/${primaryPlayable.artifact_id.slice(7)}`}>Play this game</a>
              )}
              <div class="seed-list">
                {runs.map((run) => {
                  const playable = run.artifacts.find(
                    (artifact) => artifact.role === "playable",
                  );
                  const source = run.artifacts.find(
                    (artifact) => artifact.role === "clean-source",
                  );
                  return (
                    <div class="seed-row">
                      <span class="mono">
                        {run.seed}
                        {run.seed === defaultOfficialSeed ? " · fixed" : ""}
                      </span>
                      <span>{run.score ? run.score.percent.toFixed(1) : "—"}</span>
                      {playable ? (
                        <a href={`/showcase/${playable.artifact_id.slice(7)}`}>Play</a>
                      ) : (
                        <span class="muted">Build failed</span>
                      )}
                      {source && <a href={source.url}>Source</a>}
                    </div>
                  );
                })}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">Game-by-game</span><h2>Where the points came from.</h2></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Game challenge</th><th>Type</th><th>Runs</th><th>Score</th><th>Variation</th></tr>
          </thead>
          <tbody>
            {publication.aggregate.tasks.map((task) => (
              <tr>
                <td>
                  <a href={`/benchmarks/${publication.benchmark.version}/games/${task.task_id}`}>
                    <span class="lang-en">{taskTitles(task.task_id).en}</span>
                    <span class="lang-zh">{taskTitles(task.task_id).zh}</span>
                  </a>
                  <div class="mono muted">{task.task_id}</div>
                </td>
                <td>{task.track === "build" ? "Made new" : "Recreated"}</td>
                <td>{task.attempts}</td>
                <td class="score">{task.mean.toFixed(1)}</td>
                <td>{task.standard_deviation.toFixed(1)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">What worked</span><h2>The score, split by capability.</h2></div>
        <p>These point totals explain the main score. They are not another leaderboard.</p>
      </div>
      <div class="grid cols-3">
        {[...categories.entries()].map(([name, category]) => (
          <div class="card metric">
            <strong>{category.earned.toFixed(1)}/{category.available.toFixed(1)}</strong>
            <span>{humanize(name)}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">What went wrong</span><h2>Every failed check stays visible.</h2></div>
        <p>{failedTests.length} failed browser check{failedTests.length === 1 ? "" : "s"} across the games above.</p>
      </div>
      {failedTests.length === 0 ? (
        <div class="callout">Every published browser check passed in the included runs.</div>
      ) : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Game</th><th>Check</th><th>Capability</th><th>Points lost</th><th>What happened</th></tr>
            </thead>
            <tbody>
              {failedTests.map(({ run, test }) => (
                <tr>
                  <td>
                    <span class="lang-en">{taskTitles(run.task_id).en}</span>
                    <span class="lang-zh">{taskTitles(run.task_id).zh}</span>
                    <div class="mono muted">seed {run.seed}</div>
                  </td>
                  <td>{humanize(test.id)}<div class="mono muted">{test.id}</div></td>
                  <td>{humanize(test.category)}</td>
                  <td>{test.points}</td>
                  <td>{test.message ?? "The expected behavior was not observed."}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">Human playtest</span><h2>Fun is a separate question.</h2></div>
        <p>The browser can check rules. It cannot tell us whether a game feels clear, polished, or enjoyable.</p>
      </div>
      {publication.review_summaries.length === 0 ? (
        <div class="callout">Human playtest results have not been attached yet. The machine score above is unchanged.</div>
      ) : (
        <div class="grid cols-3">
          {publication.review_summaries.map((review) => (
            <article class="card">
              <h3>
                <span class="lang-en">{taskTitles(review.task_id).en}</span>
                <span class="lang-zh">{taskTitles(review.task_id).zh}</span>
              </h3>
              <p>
                {review.sample_count} samples · {review.outcomes.wins} wins ·
                {" "}{review.outcomes.losses} losses · {review.outcomes.ties} ties ·
                {" "}{review.outcomes.both_bad} both bad
              </p>
              <p class="mono">{Object.entries(review.tags).map(([tag, count]) => `${tag}:${count}`).join(" · ")}</p>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="section prose identity">
      <div class="section-head">
        <div><span class="eyebrow">For auditors</span><h2>Exact runs, files, and identities.</h2></div>
        <p>Most people can stop here. These records exist so researchers can reproduce and challenge the result.</p>
      </div>

      <details class="audit">
        <summary>Physical runs, timing, usage, and verification</summary>
        <div class="audit-body table-wrap">
        <table>
          <thead>
            <tr>
              <th>Run</th><th>Task</th><th>Seed</th><th>Score</th><th>Exit</th>
              <th>Time</th><th>Tokens / cost</th><th>Verification</th>
            </tr>
          </thead>
          <tbody>
            {publication.runs.map((run) => (
              <tr>
                <td class="mono" title={run.run_id}>{run.run_id.slice(0, 10)}…</td>
                <td>
                  <span class="lang-en">{taskTitles(run.task_id).en}</span>
                  <span class="lang-zh">{taskTitles(run.task_id).zh}</span>
                  {!run.included && <div class="muted">excluded</div>}
                </td>
                <td class="mono">{run.seed}</td>
                <td class="score">{run.score ? run.score.percent.toFixed(1) : "—"}</td>
                <td>{humanize(run.exit_reason)}</td>
                <td>{run.wall_time_ms === undefined ? "Not reported" : `${(run.wall_time_ms / 1000).toFixed(1)}s`}</td>
                <td>
                  {run.usage ? (
                    <>
                      {run.usage.input_tokens ?? "?"} in /
                      {" "}{run.usage.output_tokens ?? "?"} out
                      <div class="muted">
                        {run.usage.cost_usd === undefined
                          ? "cost not reported"
                          : `$${run.usage.cost_usd.toFixed(4)}`}
                      </div>
                    </>
                  ) : "Not reported"}
                </td>
                <td>
                  {run.verification
                    ? `${run.verification.status} · ${run.verification.network_attestation}`
                    : "Unverified"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </details>

      <details class="audit">
        <summary>Published source, game builds, screenshots, and licenses</summary>
        <div class="audit-body table-wrap">
        <table>
          <thead><tr><th>Run</th><th>Role</th><th>File</th><th>Bytes</th><th>Content ID</th></tr></thead>
          <tbody>
            {publication.runs.flatMap((run) =>
              run.artifacts.map((artifact) => (
                <tr>
                  <td class="mono">{run.run_id.slice(0, 10)}…</td>
                  <td>{artifact.role}</td>
                  <td><a href={artifact.url}>{artifact.file_name}</a></td>
                  <td>{artifact.size_bytes}</td>
                  <td class="mono">{artifact.artifact_id.slice(0, 23)}…</td>
                </tr>
              )),
            )}
          </tbody>
        </table>
        </div>
      </details>

      <details class="audit">
        <summary>Immutable IDs and model parameters</summary>
        <div class="audit-body">
          <p><strong>Publication</strong><br /><code>{publication.publication_id}</code></p>
          <p><strong>Configuration</strong><br /><code>{publication.configuration.configuration_id}</code></p>
          <p><strong>Model parameters</strong><br /><code>{JSON.stringify(publication.configuration.agent.parameters)}</code></p>
          <p><strong>Series</strong><br /><code>{publication.series_id}</code></p>
          <p><strong>Release lock</strong><br /><code>{publication.benchmark.release_hash}</code></p>
          <p><strong>Source commit</strong><br /><code>{publication.benchmark.git_commit}</code></p>
          <p><strong>Evaluator image</strong><br /><code>{imageDigests.length > 0 ? imageDigests.join(", ") : "Not verified"}</code></p>
        </div>
      </details>
    </section>
  </div>
</Layout>
