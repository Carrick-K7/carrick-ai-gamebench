---
import Layout from "../layouts/Layout.astro";
import {
  defaultOfficialSeed,
  gameData,
  releaseData,
  resultData,
  score,
} from "../lib/data";

const [games, releases, results] = await Promise.all([
  gameData(),
  releaseData(),
  resultData(),
]);
const latest = releases[0];
const activeRecords = results.records.filter(
  ({ entry }) =>
    entry.status === "active" &&
    entry.benchmark_version === latest?.benchmark_version,
);
const experimental = activeRecords
  .filter(({ entry }) => entry.tier === "experimental")
  .sort(
    (left, right) =>
      (right.entry.aggregate.leaderboards.core ?? -1) -
        (left.entry.aggregate.leaderboards.core ?? -1),
  );
const publicArtifacts = activeRecords.flatMap(({ publication }) =>
  publication.runs.flatMap((run) => run.artifacts),
);
const showcasePool = activeRecords.flatMap((record) =>
  record.publication.runs
    .filter((run) => run.included && run.seed === defaultOfficialSeed)
    .flatMap((run) => {
      const playable = run.artifacts.find((artifact) => artifact.role === "playable");
      const showcase = run.artifacts.find(
        (artifact) =>
          artifact.role === "screenshot" &&
          artifact.file_name ===
            `${run.task_id.replace(/[^a-zA-Z0-9._-]+/g, "-")}-showcase.png`,
      );
      return playable && showcase ? [{ record, run, playable, showcase }] : [];
    }),
);
const featured: typeof showcasePool = [];
const usedModels = new Set<string>();
const usedTasks = new Set<string>();
for (const candidate of showcasePool) {
  if (
    featured.length < 3 &&
    !usedModels.has(candidate.record.entry.agent.model) &&
    !usedTasks.has(candidate.run.task_id)
  ) {
    featured.push(candidate);
    usedModels.add(candidate.record.entry.agent.model);
    usedTasks.add(candidate.run.task_id);
  }
}
const titleByTask = new Map(
  games.map((game) => [game.manifest.id, game.manifest.title]),
);
---

<Layout title="GameBench" description="Play the games coding agents made, inspect every score, and judge the result for yourself.">
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">The coding benchmark you can actually play</span>
        <h1>Models made the games. <em>You get the controller.</em></h1>
        <p class="lead">
          GameBench asks coding agents to build real browser games. We test the
          rules and controls, then let people play the result. No demo video.
          No hidden judge. The game is the proof.
        </p>
        <div class="actions">
          <a class="button" href="/games">Play the games</a>
          <a class="button secondary" href="/leaderboard">See model scores</a>
        </div>
      </div>
      <div class="hero-stage" aria-label="Games generated by coding agents">
        {featured.map(({ record, run, playable, showcase }) => (
          <a class="hero-game" href={`/showcase/${playable.artifact_id.slice(7)}`}>
            <img src={showcase.url} alt={`${titleByTask.get(run.task_id)?.en ?? run.task_id}, made by ${record.entry.agent.model}`} />
            <span class="hero-caption">
              <span>
                {record.entry.agent.model} ·
                {" "}<span class="lang-en">{titleByTask.get(run.task_id)?.en ?? run.task_id}</span>
                <span class="lang-zh">{titleByTask.get(run.task_id)?.zh ?? run.task_id}</span>
              </span>
              <span class="score-chip">{run.score?.percent.toFixed(0) ?? "—"}</span>
            </span>
          </a>
        ))}
        <span class="hero-badge">Play<br />the proof</span>
      </div>
    </section>

    <section class="section">
      <div class="grid cols-4">
        <div class="card metric"><strong>{games.length}</strong><span>different game challenges</span></div>
        <div class="card metric"><strong>{experimental.length}</strong><span>public model runs</span></div>
        <div class="card metric">
          <strong>{publicArtifacts.filter((artifact) => artifact.role === "playable").length}</strong>
          <span>games ready to play</span>
        </div>
        <div class="card metric"><strong>v{latest?.benchmark_version ?? "—"}</strong><span>current ruleset</span></div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Jump in</span>
          <h2>Three games. Three models. Zero setup.</h2>
        </div>
        <p>Each game opens in an isolated player. Try the controls, break the rules, and decide whether the score matches the experience.</p>
      </div>
      <div class="grid cols-3">
        {featured.map(({ record, run, playable, showcase }) => (
          <article class="card output-card">
            <img class="cover" src={showcase.url} alt={`${titleByTask.get(run.task_id)?.en ?? run.task_id} generated by ${record.entry.agent.model}`} loading="lazy" />
            <div class="output-meta">
              <span class={`pill ${record.entry.tier}`}>{record.entry.tier}</span>
              <span class="pill">score {run.score?.percent.toFixed(0) ?? "—"}</span>
            </div>
            <h3>
              <span class="lang-en">{titleByTask.get(run.task_id)?.en ?? run.task_id}</span>
              <span class="lang-zh">{titleByTask.get(run.task_id)?.zh ?? run.task_id}</span>
            </h3>
            <p>
              <span class="lang-en">Built by <strong>{record.entry.agent.model}</strong>. The score checks whether the game behaves correctly; your hands judge the feel.</span>
              <span class="lang-zh">这是 <strong>{record.entry.agent.model}</strong> 做出的版本。自动测试看它做得对不对，好不好玩由你判断。</span>
            </p>
            <a class="button" href={`/showcase/${playable.artifact_id.slice(7)}`}>Start playing</a>
          </article>
        ))}
      </div>
      <div class="actions"><a class="button secondary" href="/games">Browse all eight challenges</a></div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">How a score is earned</span><h2>Build it. Test it. Play it.</h2></div>
        <p>The machine score and the human verdict answer different questions, so GameBench never blends them into a mystery number.</p>
      </div>
      <div class="grid cols-3 how-grid">
        <article class="card how-card">
          <h3>The model builds</h3>
          <p>Every agent starts from the same small web project, task, time limit, and game rules.</p>
        </article>
        <article class="card how-card">
          <h3>The browser tests</h3>
          <p>Real keyboard and pointer actions check controls, game state, reset behavior, stability, and winning rules.</p>
        </article>
        <article class="card how-card">
          <h3>People play</h3>
          <p>Humans judge clarity, polish, feel, and fun separately from the automatic score.</p>
        </article>
      </div>
      <div class="actions"><a class="button secondary" href="/methodology">See exactly how scoring works</a></div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">Current lab results</span><h2>No champion yet. Plenty to play.</h2></div>
        <p>These stage results use one reproducible sample. They are useful evidence, but they are not the complete Official leaderboard.</p>
      </div>
      <div class="grid">
        {experimental.slice(0, 5).map(({ entry }, index) => (
          <a class="card result-card" href={`/results/${entry.publication_id.slice(7)}`} style="text-decoration:none">
            <span class="result-rank">{String(index + 1).padStart(2, "0")}</span>
            <span>
              <strong>{entry.agent.model}</strong>
              <span class="muted"> · {entry.agent.id} · GameBench {entry.benchmark_version}</span>
            </span>
            <span class="result-score">
              {score(entry.aggregate.leaderboards.core)}
              <small>{entry.aggregate.leaderboards.core === undefined ? "incomplete run" : "core score"}</small>
            </span>
          </a>
        ))}
      </div>
      <div class="actions">
        <a class="button" href="/leaderboard">Open every result</a>
        <a class="button secondary" href="/methodology">How results qualify</a>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">Nothing up our sleeve</span><h2>Every point has a trail.</h2></div>
      </div>
      <div class="grid cols-3">
        <article class="card"><h3>Play the exact output</h3><p>The game you open is the content-addressed build attached to that scored run.</p></article>
        <article class="card"><h3>Read the clean source</h3><p>Public source excludes model logs, credentials, caches, and private provider responses.</p></article>
        <article class="card"><h3>Audit the tests</h3><p>Task rules, point weights, failures, versions, and immutable result records are public.</p></article>
      </div>
    </section>

    <section class="section about-section">
      <figure class="about-visual">
        <img src="/og.png" alt="Carrick AI GameBench · Play the proof" loading="lazy" />
      </figure>
      <div class="about-copy">
        <span class="eyebrow"><span class="lang-en">About Carrick AI GameBench</span><span class="lang-zh">关于 Carrick AI GameBench</span></span>
        <h2><span class="lang-en">The game is the evidence.</span><span class="lang-zh">游戏本身，就是评测证据。</span></h2>
        <p class="lead">
          <span class="lang-en">GameBench turns AI coding ability into something people can inspect with their own hands. Automated tests measure whether the rules work; playable builds reveal whether the result feels complete.</span>
          <span class="lang-zh">GameBench 把 AI 编程能力变成每个人都能亲手验证的成果。自动测试检查规则是否正确，可试玩成品则让你直接判断游戏是否真的完整、好用。</span>
        </p>
        <div class="actions">
          <a class="button" href="/methodology"><span class="lang-en">Read the evaluation rules</span><span class="lang-zh">了解评测规则</span></a>
          <a class="button secondary" href="/source"><span class="lang-en">Explore the open benchmark</span><span class="lang-zh">查看开放内容</span></a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-section { align-items: center; display: grid; gap: clamp(28px, 5vw, 70px); grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr); }
  .about-visual { background: var(--panel-solid); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); margin: 0; overflow: hidden; }
  .about-visual img { display: block; height: auto; width: 100%; }
  .about-copy h2 { font-size: clamp(34px, 4.2vw, 58px); margin-top: 12px; }
  .about-copy .lead { font-size: clamp(16px, 1.6vw, 20px); }
  @media (max-width: 840px) { .about-section { grid-template-columns: 1fr; } }
</style>
