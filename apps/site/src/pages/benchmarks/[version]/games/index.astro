---
import GameCatalogView from "../../../../components/GameCatalogView.astro";
import Layout from "../../../../layouts/Layout.astro";
import { releaseCatalogData, resultData } from "../../../../lib/data";

export async function getStaticPaths() {
  const catalogs = await releaseCatalogData();
  return catalogs.map((catalog) => ({
    params: { version: catalog.release.benchmark_version },
    props: { catalog },
  }));
}

const { catalog } = Astro.props;
const { records } = await resultData();
---

<Layout title={`v${catalog.release.benchmark_version} games`}>
  <div class="container">
    <span class="eyebrow">GameBench season v{catalog.release.benchmark_version}</span>
    <h1>Choose a challenge.</h1>
    <p class="lead">
      Every model on this page faced the same game rules and browser checks.
      Switch versions only when you want to inspect an older ruleset.
    </p>
    <div class="actions">
      <a
        class="button secondary"
        href={`/benchmarks/${catalog.release.benchmark_version}/leaderboard`}
      >
        Official board
      </a>
      <a
        class="button secondary"
        href={`/releases/${catalog.release.benchmark_version}`}
      >
        Version details
      </a>
    </div>
    <section class="section">
      <GameCatalogView catalog={catalog} records={records} />
    </section>
  </div>
</Layout>
