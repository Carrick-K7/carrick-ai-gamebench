---
import RankingsPage from "../../../components/RankingsPage.astro";
import Layout from "../../../layouts/Layout.astro";
import { releaseData, resultData } from "../../../lib/data";

export async function getStaticPaths() {
  const releases = await releaseData();
  return releases.map((release) => ({
    params: { version: release.benchmark_version },
    props: { release },
  }));
}

const { release } = Astro.props;
const [releases, { records }] = await Promise.all([releaseData(), resultData()]);
---

<Layout title={`v${release.benchmark_version} evaluation rankings`} titleZh={`v${release.benchmark_version} 评测排行`}>
  <RankingsPage version={release.benchmark_version} releases={releases} records={records} />
</Layout>
