---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found">
  <div class="container">
    <span class="eyebrow">404</span>
    <h1>Wrong portal. The games are this way.</h1>
    <p class="lead">That address is not part of the current GameBench arcade.</p>
    <div class="actions"><a class="button" href="/games">Choose a game</a><a class="button secondary" href="/">Return home</a></div>
  </div>
</Layout>
