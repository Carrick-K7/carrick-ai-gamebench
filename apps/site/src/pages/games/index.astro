---
import GameCatalogView from "../../components/GameCatalogView.astro";
import Layout from "../../layouts/Layout.astro";
import { releaseCatalogData, resultData } from "../../lib/data";

const [catalogs, results] = await Promise.all([
  releaseCatalogData(),
  resultData(),
]);
const current = catalogs[0];
---

<Layout title="Games" description="Versioned game tasks and generated outputs in GameBench.">
  <div class="container">
    <span class="eyebrow">Choose your game</span>
    <h1>Eight challenges. Dozens of model-made versions.</h1>
    <p class="lead">
      Open a challenge to play different models solving the same brief. Six
      games are made from scratch; two ask the model to recreate an existing
      open-source game.
    </p>

    {current && (
      <div class="version-context">
        <span class="pill">v{current.release.benchmark_version} · current</span>
        <p>
          <span class="lang-en">The test set evolves over time. Games shown here always come from the current release; earlier contracts remain available in the version archive.</span>
          <span class="lang-zh">测试集会持续迭代。这里默认只展示当前版本；较早的任务规则仍保留在版本档案中，方便审计。</span>
        </p>
        <a href="/releases"><span class="lang-en">About versioning</span><span class="lang-zh">了解版本迭代</span></a>
      </div>
    )}

    {current && (
      <section class="section">
        <div class="section-head">
          <div>
            <span class="eyebrow">Current season · v{current.release.benchmark_version}</span>
            <h2>Pick a challenge.</h2>
          </div>
          <p>Each card shows how many model-made builds are ready to play.</p>
        </div>
        <GameCatalogView catalog={current} records={results.records} />
      </section>
    )}
  </div>
</Layout>

<style>
  .version-context { align-items: center; display: flex; flex-wrap: wrap; gap: 12px 18px; margin-top: 30px; }
  .version-context p { margin: 0; max-width: 760px; }
  .version-context a { font-size: 13px; font-weight: 800; }
</style>
