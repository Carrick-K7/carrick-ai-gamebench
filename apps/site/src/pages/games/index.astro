---
import GameCatalogView from "../../components/GameCatalogView.astro";
import Layout from "../../layouts/Layout.astro";
import { releaseCatalogData, resultData } from "../../lib/data";

const [catalogs, results] = await Promise.all([
  releaseCatalogData(),
  resultData(),
]);
const current = catalogs[0];
---

<Layout title="Games" description="Versioned game tasks and generated outputs in GameBench.">
  <div class="container">
    <span class="eyebrow">Evaluation set</span>
    <h1>Games expose what code alone can hide.</h1>
    <p class="lead">
      Build tasks create games from specifications. Reproduce tasks recover an
      existing open-source game's behavior from licensed reference material.
      Each catalog is frozen by Benchmark version.
    </p>

    <div class="actions">
      {catalogs.map(({ release }) => (
        <a
          class={`button ${release.benchmark_version === current?.release.benchmark_version ? "" : "secondary"}`}
          href={`/benchmarks/${release.benchmark_version}/games`}
        >
          v{release.benchmark_version}
        </a>
      ))}
    </div>

    {current && (
      <section class="section">
        <div class="section-head">
          <div>
            <span class="eyebrow">Current catalog</span>
            <h2>Benchmark v{current.release.benchmark_version}</h2>
          </div>
          <p>{current.release.task_count} immutable task contracts.</p>
        </div>
        <GameCatalogView catalog={current} records={results.records} />
      </section>
    )}
  </div>
</Layout>
