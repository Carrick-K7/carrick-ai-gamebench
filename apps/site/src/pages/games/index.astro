---
import GameCatalogView from "../../components/GameCatalogView.astro";
import Layout from "../../layouts/Layout.astro";
import { releaseCatalogData, resultData } from "../../lib/data";

const [catalogs, results] = await Promise.all([
  releaseCatalogData(),
  resultData(),
]);
const current = catalogs[0];
---

<Layout title="Games" description="Versioned game tasks and generated outputs in GameBench.">
  <div class="container">
    <span class="eyebrow">Choose your game</span>
    <h1>Eight challenges. Dozens of model-made versions.</h1>
    <p class="lead">
      Open a challenge to play different models solving the same brief. Six
      games are made from scratch; two ask the model to recreate an existing
      open-source game.
    </p>

    <div class="actions">
      {catalogs.map(({ release }) => (
        <a
          class={`button ${release.benchmark_version === current?.release.benchmark_version ? "" : "secondary"}`}
          href={`/benchmarks/${release.benchmark_version}/games`}
        >
          v{release.benchmark_version}
        </a>
      ))}
    </div>

    {current && (
      <section class="section">
        <div class="section-head">
          <div>
            <span class="eyebrow">Current season · v{current.release.benchmark_version}</span>
            <h2>Pick a challenge.</h2>
          </div>
          <p>Each card shows how many model-made builds are ready to play.</p>
        </div>
        <GameCatalogView catalog={current} records={results.records} />
      </section>
    )}
  </div>
</Layout>
