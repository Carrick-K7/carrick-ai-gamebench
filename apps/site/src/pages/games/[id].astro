---
import GameDetailView from "../../components/GameDetailView.astro";
import Layout from "../../layouts/Layout.astro";
import { releaseCatalogData, resultData } from "../../lib/data";

export async function getStaticPaths() {
  const catalogs = await releaseCatalogData();
  const current = catalogs[0];
  if (!current) {
    return [];
  }
  return current.tasks.map((task) => ({
    params: { id: task.id },
    props: { catalog: current, taskId: task.id },
  }));
}

const { catalog, taskId } = Astro.props;
const { records } = await resultData();
const releasedTask = catalog.tasks.find((task: { id: string }) => task.id === taskId);
const title = releasedTask?.source?.manifest.title.en ?? taskId;
const titleZh = releasedTask?.source?.manifest.title.zh ?? title;
---

<Layout title={title} titleZh={titleZh}>
  <div class="container">
    <div class="callout">
      Current-version shortcut. Canonical URL:
      <a href={`/benchmarks/${catalog.release.benchmark_version}/games/${taskId}`}>
        /benchmarks/{catalog.release.benchmark_version}/games/{taskId}
      </a>
    </div>
    <GameDetailView catalog={catalog} taskId={taskId} records={records} />
  </div>
</Layout>
