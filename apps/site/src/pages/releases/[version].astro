---
import Layout from "../../layouts/Layout.astro";
import { releaseCatalogData } from "../../lib/data";

export async function getStaticPaths() {
  const catalogs = await releaseCatalogData();
  return catalogs.map((catalog, index) => ({
    params: { version: catalog.release.benchmark_version },
    props: { catalog, previous: catalogs[index + 1] },
  }));
}

const { catalog, previous } = Astro.props;
const release = catalog.release;
const previousTasks = new Map(
  (previous?.release.tasks ?? []).map((task: { id: string }) => [task.id, task]),
);
const currentTasks = new Map(release.tasks.map((task) => [task.id, task]));
const added = release.tasks.filter((task) => !previousTasks.has(task.id));
const removed = (previous?.release.tasks ?? []).filter(
  (task: { id: string }) => !currentTasks.has(task.id),
);
const changed = release.tasks.filter((task) => {
  const prior = previousTasks.get(task.id) as
    | { version: string; hash: string }
    | undefined;
  return prior && (prior.version !== task.version || prior.hash !== task.hash);
});
const protocolChanged =
  previous &&
  JSON.stringify(previous.release.protocols) !== JSON.stringify(release.protocols);
const scoringChanged =
  previous &&
  JSON.stringify("scoring" in previous.release ? previous.release.scoring : null) !==
    JSON.stringify("scoring" in release ? release.scoring : null);
const seedPolicyChanged =
  previous &&
  JSON.stringify("official" in previous.release ? previous.release.official : null) !==
    JSON.stringify("official" in release ? release.official : null);
const taskTitles = (task: (typeof catalog.tasks)[number]) =>
  task.source?.manifest.title ?? { en: task.id, zh: task.id };
---

<Layout title={`Release v${release.benchmark_version}`}>
  <div class="container">
    <span class="eyebrow">GameBench season</span>
    <h1>GameBench v{release.benchmark_version}</h1>
    <p class="lead">
      <span class="lang-en">{release.task_count} game challenges share one scoring ruleset. Results from this version compete only with other v{release.benchmark_version} runs.</span>
      <span class="lang-zh">{release.task_count} 个游戏任务共用一套评分规则；本版本只和同为 v{release.benchmark_version} 的结果比较。</span>
    </p>
    <div class="actions">
      <a
        class="button"
        href={`/benchmarks/${release.benchmark_version}/leaderboard`}
      >
        Official board
      </a>
      <a
        class="button secondary"
        href={`/benchmarks/${release.benchmark_version}/games`}
      >
        Play the games
      </a>
      <a
        class="button secondary"
        href={`https://github.com/Carrick-K7/carrick-ai-gamebench/tree/v${release.benchmark_version}`}
      >
        Frozen source tag
      </a>
    </div>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">Games in this season</span><h2>The complete challenge list.</h2></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Game challenge</th><th>Type</th><th>Version</th><th>Source retained</th><th>Content ID</th></tr>
          </thead>
          <tbody>
            {catalog.tasks.map((task) => (
              <tr>
                <td>
                  <a href={`/benchmarks/${release.benchmark_version}/games/${task.id}`}>
                    <span class="lang-en">{taskTitles(task).en}</span>
                    <span class="lang-zh">{taskTitles(task).zh}</span>
                  </a>
                  <div class="mono muted">{task.id}</div>
                </td>
                <td>{task.track === "build" ? "Made new" : "Recreated"}</td>
                <td class="mono">{task.version}</td>
                <td>{task.source ? "Yes" : "Identity only"}</td>
                <td class="mono">{task.hash.slice(0, 23)}…</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section prose">
      <h2><span class="lang-en">Built to improve without rewriting history.</span><span class="lang-zh">持续改进，也保留每次变化。</span></h2>
      <p><span class="lang-en">GameBench uses explicit releases whenever tasks, tests, or evaluation rules change. The current page is complete on its own; comparison details are available when needed.</span><span class="lang-zh">任务、测试或评测规则发生变化时，GameBench 会发布新版本。当前页面已经包含使用这一版所需的信息，版本差异可按需展开查看。</span></p>
      <details class="audit">
        <summary><span class="lang-en">Changes since the previous release</span><span class="lang-zh">查看相对上一版的变化</span></summary>
        <div class="audit-body">
        {!previous ? (
          <div class="callout">Initial retained Benchmark release.</div>
        ) : (
          <div class="grid cols-3">
          <article class="card">
            <h3>Tasks</h3>
            <p>
              <span class="lang-en">{added.length} added · {removed.length} removed · {changed.length} changed in place</span>
              <span class="lang-zh">新增 {added.length} 项 · 移除 {removed.length} 项 · 修改 {changed.length} 项</span>
            </p>
            {[...added, ...removed, ...changed].length > 0 && (
              <ul>
                {added.map((task) => <li>Added <code>{task.id}</code></li>)}
                {removed.map((task: { id: string }) => <li>Removed <code>{task.id}</code></li>)}
                {changed.map((task) => <li>Changed <code>{task.id}</code></li>)}
              </ul>
            )}
          </article>
          <article class="card">
            <h3>Protocols and scoring</h3>
            <p>
              <span class="lang-en">Protocols {protocolChanged ? "changed" : "unchanged"} · scoring {scoringChanged ? "changed" : "unchanged"}.</span>
              <span class="lang-zh">协议{protocolChanged ? "有变化" : "无变化"} · 评分{scoringChanged ? "有变化" : "无变化"}。</span>
            </p>
          </article>
          <article class="card">
            <h3>Official run policy</h3>
            <p>
              <span class="lang-en">{seedPolicyChanged ? "Fixed seeds or attempt policy changed." : "Unchanged."}</span>
              <span class="lang-zh">{seedPolicyChanged ? "固定种子或尝试规则已变更。" : "未变更。"}</span>
            </p>
          </article>
          </div>
        )}
        </div>
      </details>
    </section>

    <section class="section prose">
      <details class="audit">
        <summary>Protocol, scoring, and Official matrix JSON</summary>
        <div class="audit-body">
          <h3>Protocols</h3><pre><code>{JSON.stringify(release.protocols, null, 2)}</code></pre>
          {"scoring" in release && (
            <><h3>Scoring</h3><pre><code>{JSON.stringify(release.scoring, null, 2)}</code></pre></>
          )}
          {"official" in release && (
            <><h3>Official matrix</h3><pre><code>{JSON.stringify(release.official, null, 2)}</code></pre></>
          )}
        </div>
      </details>
    </section>
  </div>
</Layout>
