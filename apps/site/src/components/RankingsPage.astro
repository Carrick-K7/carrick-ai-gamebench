---
import { compareSemanticVersions } from "@carrick/gamebench-core";
import LeaderboardView from "./LeaderboardView.astro";
import type { PublicationRecord } from "../lib/data";
import { rankingTierOrder } from "../lib/ranking";

interface ReleaseSummary {
  benchmark_version: string;
  task_count: number;
}

interface Props {
  version: string;
  releases: ReleaseSummary[];
  records: PublicationRecord[];
  isShortcut?: boolean;
}

const { version, releases, records, isShortcut = false } = Astro.props;
const buildPrimary = compareSemanticVersions(version, "0.5.0") >= 0;
const lightweight = compareSemanticVersions(version, "0.6.0") >= 0;
const hasReproduceReport = buildPrimary && !lightweight;
const activeForVersion = records.filter(
  ({ entry }) => entry.benchmark_version === version && entry.status === "active",
);
const officialCount = activeForVersion.filter(({ entry }) => entry.tier === "official").length;
const experimentalCount = activeForVersion.filter(({ entry }) => entry.tier === "experimental").length;
const officialRanksFirst = rankingTierOrder(officialCount)[0] === "official";
const currentVersion = releases[0]?.benchmark_version;
const isCurrentVersion = version === currentVersion;
const isLatestResultFallback =
  isShortcut && !isCurrentVersion && currentVersion !== undefined;
---

<div class="container">
  <span class="eyebrow"><span class="lang-en">Evaluation rankings</span><span class="lang-zh">评测排行</span></span>
  <h1><span class="lang-en">Scores you can play.</span><span class="lang-zh">分数之外，游戏也能亲手验证。</span></h1>
  <p class="lead">
    <span class="lang-en">Every row links to the machine-contract checks, clean source, playable output, and exact evaluation record. Results from different benchmark releases are never mixed.</span>
    <span class="lang-zh">每条成绩都能追溯到机器契约检查、整理后的源码、可玩成品和完整评测记录。不同测试集版本不会混排。</span>
  </p>

  <div class="version-context">
    <span class="pill">v{version} · {isCurrentVersion ? "current release" : "historical ruleset"}</span>
    <p>
      {isLatestResultFallback ? (
        <>
          <span class="lang-en">The current release is v{currentVersion}, but it has no published result yet. This shortcut shows the newest release that has measured results: v{version}.</span>
          <span class="lang-zh">当前版本是 v{currentVersion}，但还没有公开成绩。此短链接展示最近一个已有实测结果的版本：v{version}。</span>
        </>
      ) : (
        <>
          <span class="lang-en">GameBench improves through versioned releases. This page keeps scores comparable by showing one ruleset at a time.</span>
          <span class="lang-zh">GameBench 会持续迭代。每个页面只比较同一版测试规则下的成绩，避免不同版本混排。</span>
        </>
      )}
    </p>
    {!isCurrentVersion && <a href={`/benchmarks/${currentVersion}/leaderboard`}><span class="lang-en">Open the current release</span><span class="lang-zh">查看当前版本</span></a>}
  </div>

  {buildPrimary && (
    <div class="callout status-banner">
      <span class="lang-en"><strong>Build is the primary board.</strong> {lightweight ? "Each of four tasks receives one Agent attempt and one canonical-seed evaluation." : "One development submission is evaluated under three fixed seeds; Reproduce is reported separately."}</span>
      <span class="lang-zh"><strong>Build 是主榜。</strong>{lightweight ? "四个任务各进行一次 Agent 开发和一次固定 seed 评测。" : "每个任务只开发一次，再用三组固定种子独立评测；Reproduce 单独展示。"}</span>
    </div>
  )}

  {officialRanksFirst ? (
    <>
      <section class="section" id="official">
        <div class="section-head">
          <div><span class="pill official">Official</span><h2><span class="lang-en">Official leaderboard</span><span class="lang-zh">正式排行</span></h2></div>
          <p>
            <span class="lang-en">{lightweight ? "Four complete tasks, one Agent attempt each, one canonical evaluation, and a passing local integrity check." : buildPrimary ? "One development submission per task, three fixed-seed evaluations, clean rebuild, and independent verification." : "Complete coverage, three fixed attempts, clean rebuild, and independent verification."}</span>
            <span class="lang-zh">{lightweight ? "完整覆盖四个任务；每项一次 Agent 开发、一次固定评测，并通过本地完整性检查。" : buildPrimary ? "每个任务开发一次，使用三组固定种子评测，并通过无密钥重建与独立复核。" : "完整覆盖全部游戏和三次固定尝试，并通过无密钥重建与独立复核。"}</span>
          </p>
        </div>
        <LeaderboardView version={version} records={records} tier="official" board="build" />
        {hasReproduceReport && (
          <details class="callout">
            <summary><strong>Independent Reproduce report</strong></summary>
            <LeaderboardView version={version} records={records} tier="official" board="reproduce" />
          </details>
        )}
      </section>
      <section class="section" id="experimental">
        <div class="section-head">
          <div><span class="pill experimental">Experimental</span><h2><span class="lang-en">Stage results</span><span class="lang-zh">阶段性成绩</span></h2></div>
          <p><span class="lang-en">Useful measured evidence, kept separate from the Official ranking.</span><span class="lang-zh">可供参考的实测结果，与正式排行分开呈现。</span></p>
        </div>
        <div class="callout status-banner"><span class="lang-en">Stage results do not represent an Official ranking.</span><span class="lang-zh">阶段性结果，不代表正式排名。</span></div>
        <LeaderboardView version={version} records={records} tier="experimental" board="build" />
        {hasReproduceReport && (
          <details class="callout">
            <summary><strong>Independent Reproduce report</strong></summary>
            <LeaderboardView version={version} records={records} tier="experimental" board="reproduce" />
          </details>
        )}
      </section>
    </>
  ) : (
    <>
      <section class="section" id="experimental">
        <div class="section-head">
          <div><span class="pill experimental">Experimental</span><h2><span class="lang-en">Current measured results</span><span class="lang-zh">当前阶段性成绩</span></h2></div>
          <p>{experimentalCount} <span class="lang-en">active result{experimentalCount === 1 ? "" : "s"} on this exact ruleset.</span><span class="lang-zh">条结果采用这一版测试规则。</span></p>
        </div>
        <div class="callout status-banner"><span class="lang-en">Stage results do not represent an Official ranking.</span><span class="lang-zh">阶段性结果，不代表正式排名。</span></div>
        <LeaderboardView version={version} records={records} tier="experimental" board="build" />
        {hasReproduceReport && (
          <details class="callout">
            <summary><strong>Independent Reproduce report</strong></summary>
            <LeaderboardView version={version} records={records} tier="experimental" board="reproduce" />
          </details>
        )}
      </section>
      <section class="section compact-section" id="official">
        <div class="section-head">
          <div><span class="pill official">Official</span><h2><span class="lang-en">Official qualification</span><span class="lang-zh">正式成绩资格</span></h2></div>
        </div>
        <div class="callout">
          <span class="lang-en">No Official result yet for v{version}. {lightweight ? "A qualifying result completes all four tasks with one Agent attempt and one canonical evaluation each, then passes the local integrity check." : buildPrimary ? "A qualifying result develops each task once, evaluates that frozen submission under all three fixed seeds, then passes clean rebuild and independent verification." : "A qualifying historical result completes all three fixed attempts for every task, then passes clean rebuild and independent verification."}</span>
          <span class="lang-zh">v{version} 目前还没有正式成绩。{lightweight ? "合格结果需完整覆盖四项任务；每项一次 Agent 开发和一次固定评测，并通过本地完整性检查。" : buildPrimary ? "合格结果需要每个任务只开发一次，再对冻结提交进行三组固定种子评测，并通过无密钥重建与独立复核。" : "历史规则要求每个任务完成三次固定尝试，并通过无密钥重建与独立复核。"}</span>
        </div>
      </section>
    </>
  )}
</div>

<style>
  .compact-section { max-width: 900px; }
  h2 { margin-top: 12px; }
  .version-context { align-items: center; display: flex; flex-wrap: wrap; gap: 12px 18px; margin-top: 30px; }
  .version-context p { margin: 0; max-width: 720px; }
  .version-context a { font-size: 13px; font-weight: 800; }
</style>
