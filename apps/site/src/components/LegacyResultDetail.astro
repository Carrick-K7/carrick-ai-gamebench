---
import Layout from "../layouts/Layout.astro";
import { releaseCatalogFor, score, type PublicationRecord } from "../lib/data";
import { sampleIndexForRun, sampleLetter, sortRunsForPresentation } from "../lib/presentation";

// Only pre-flat publication records enter this historical view.
const { record } = Astro.props as { record: PublicationRecord };
const { publication, entry } = record;
const catalog = await releaseCatalogFor(publication.benchmark.version);
const taskTitles = (taskId: string) => {
  const title = catalog?.tasks.find((task) => task.id === taskId)?.source?.manifest.title;
  return title ?? { en: taskId, zh: taskId };
};
const taskTitle = (taskId: string) => taskTitles(taskId).en;
const humanize = (value: string) => value
  .replace(/[-_.]+/g, " ")
  .replace(/\b\w/g, (letter) => letter.toUpperCase());
const modern = publication.schema_version === 2;
const reproducePrimary = publication.board === "reproduce";
const included = publication.runs.filter((run) => run.included);
const includedSubmissions = publication.submissions.filter((submission) => submission.included);
const verified = includedSubmissions.filter((submission) =>
  submission.evaluations.some((evaluation) => evaluation.verification),
).length;
const failedTests = included.flatMap((run) =>
  (run.score?.tests ?? [])
    .filter((test) => !test.passed)
    .map((test) => ({ run, test })),
);
const categories = new Map<string, { earned: number; available: number }>();
for (const run of included) {
  for (const [name, category] of Object.entries(run.score?.categories ?? {})) {
    const current = categories.get(name) ?? { earned: 0, available: 0 };
    categories.set(name, {
      earned: current.earned + category.earned,
      available: current.available + category.available,
    });
  }
}
const imageDigests = [...new Set(
  included.flatMap((run) =>
    run.verification ? [run.verification.evaluator_image_digest] : [],
  ),
)];
const firstEvaluationIds = new Set(
  publication.submissions.flatMap((submission) => {
    const first = sortRunsForPresentation(submission.evaluations)[0];
    return first ? [first.run_id] : [];
  }),
);
const artifactRows = publication.submissions.flatMap((submission) => [
  ...submission.artifacts.map((artifact) => ({
    owner: submission.submission_id,
    kind: modern ? "submission" : "run",
    artifact,
  })),
  ...(modern
    ? submission.evaluations.flatMap((evaluation) =>
        evaluation.evaluation_artifacts.map((artifact) => ({
          owner: evaluation.run_id,
          kind: "evaluation",
          artifact,
        })),
      )
    : []),
]);
const supersededBy = entry.superseded_by?.slice("sha256:".length);
const sampleFor = (run: (typeof publication.runs)[number]) => {
  const taskRuns = included.filter((candidate) => candidate.task_id === run.task_id);
  const index = sampleIndexForRun(taskRuns, run.run_id);
  return sampleLetter(Math.max(index, 0));
};
---

<Layout title={`${publication.configuration.agent.model} result`}>
  <div class="container">
    {entry.status !== "active" && (
      <div class="callout status-banner">
        This publication is <strong>{entry.status}</strong>.
        {supersededBy && (
          <> Use the <a href={`/results/${supersededBy}`}>replacement publication</a> for discovery.</>
        )}
        The immutable historical record remains available.
      </div>
    )}

    <div class="output-meta">
      <span class={`pill ${publication.tier}`}>{publication.tier}</span>
      <span class="pill">{entry.status}</span>
      <span class="pill">{verified}/{includedSubmissions.length} submissions verified</span>
    </div>
    <h1>{publication.configuration.agent.model}</h1>
    <p class="lead">
      <span class="lang-en">
        {modern
          ? `One development submission per task, followed by fixed-seed machine evaluation across ${publication.aggregate.tasks.length} game challenges.`
          : `Historical attempt-based result across ${publication.aggregate.tasks.length} game challenges.`}
        {" "}Open any game below, inspect the machine-contract score, or read the clean source. Tested with {publication.configuration.agent.id} on
        GameBench {publication.benchmark.version}.
      </span>
      <span class="lang-zh">
        {modern
          ? `每个任务只开发一次，再用固定种子对冻结提交进行机器评测，共覆盖 ${publication.aggregate.tasks.length} 个游戏任务。`
          : `这是一条历史尝试制成绩，共覆盖 ${publication.aggregate.tasks.length} 个游戏任务。`}
        你可以直接试玩、核对机器契约分数，也可以查看整理后的源码。本次使用 {publication.configuration.agent.id}，基准版本为 GameBench {publication.benchmark.version}。
      </span>
    </p>

    <div class="grid cols-4 section">
      {modern ? (
        <>
          <div class="card metric">
            <strong>{score(reproducePrimary ? publication.aggregate.leaderboards.reproduce : publication.aggregate.leaderboards.build)}</strong>
            <span>{reproducePrimary ? "Reproduce · independent machine-contract report" : "Build · primary machine-contract score"}</span>
          </div>
          <div class="card metric">
            <strong>{reproducePrimary
              ? `${publication.aggregate.evaluation_coverage.reproduce.completed}/${publication.aggregate.evaluation_coverage.reproduce.required}`
              : `${publication.aggregate.evaluation_coverage.build.completed}/${publication.aggregate.evaluation_coverage.build.required}`}</strong>
            <span>{reproducePrimary ? "Reproduce seed evaluations" : "Build seed evaluations"}</span>
          </div>
          <div class="card metric muted"><strong>1</strong><span>Agent development invocation per task</span></div>
          <div class="card metric muted"><strong>{publication.aggregate.tasks.length}</strong><span>{reproducePrimary ? "Reproduce tasks" : "Build tasks"}</span></div>
        </>
      ) : (
        <>
          <div class="card metric"><strong>{score(publication.aggregate.leaderboards.core)}</strong><span>Core · Build and Reproduce combined</span></div>
          <div class="card metric"><strong>{score(publication.aggregate.leaderboards.build)}</strong><span>Build · new games</span></div>
          <div class="card metric"><strong>{score(publication.aggregate.leaderboards.reproduce)}</strong><span>Reproduce · remade games</span></div>
          <div class="card metric"><strong>{publication.aggregate.coverage.core.completed}/{publication.aggregate.coverage.core.required}</strong><span>attempted games completed</span></div>
        </>
      )}
    </div>

    <section class="section">
      <div class="section-head">
        <div><span class="eyebrow">What the model made</span><h2>Do not just read the score. Play it.</h2></div>
        <p>{modern
          ? "The one submitted game is shown with all fixed-seed evaluations; no second development attempt is substituted."
          : "The fixed presentation attempt appears first. We do not select the prettiest screenshot or highest-scoring attempt."}</p>
      </div>
      <div class="grid cols-3">
        {publication.aggregate.tasks.map((task) => {
          const runs = sortRunsForPresentation(included.filter((run) => run.task_id === task.task_id));
          const primaryRun = runs[0];
          const primaryPlayable = primaryRun?.artifacts.find((artifact) => artifact.role === "playable");
          const showcaseName = `${task.task_id.replace(/[^a-zA-Z0-9._-]+/g, "-")}-showcase.png`;
          const primaryShowcase = primaryRun?.artifacts.find((artifact) => artifact.role === "screenshot" && artifact.file_name === showcaseName);
          return (
            <article class="card output-card">
              {primaryShowcase ? (
                <img class="cover" src={primaryShowcase.url} alt={`${taskTitle(task.task_id)} generated by ${publication.configuration.agent.model}`} loading="lazy" />
              ) : <div class="cover placeholder">No playable cover was produced</div>}
              <div class="output-meta"><span class="pill">{task.track === "build" ? "made new" : "recreated"}</span><span class="pill">score {task.mean.toFixed(0)}</span></div>
              <h3><a href={`/benchmarks/${publication.benchmark.version}/games/${task.task_id}`}><span class="lang-en">{taskTitles(task.task_id).en}</span><span class="lang-zh">{taskTitles(task.task_id).zh}</span></a></h3>
              <p>{modern ? `One development submission · ${runs.length} fixed-seed evaluation${runs.length === 1 ? "" : "s"}.` : `${runs.length} scored attempt${runs.length === 1 ? "" : "s"}.`}{" "}Open the game, source, or exact test record below.</p>
              {primaryPlayable && <a class="button" href={`/showcase/${primaryPlayable.artifact_id.slice(7)}`}>Play this game</a>}
              <div class="seed-list">
                {runs.map((run, runIndex) => {
                  const playable = run.artifacts.find((artifact) => artifact.role === "playable");
                  const source = run.artifacts.find((artifact) => artifact.role === "clean-source");
                  return (
                    <div class="seed-row">
                      <span class="mono"><span class="lang-en">{modern ? "Evaluation" : "Attempt"} {sampleLetter(runIndex)}{runIndex === 0 ? " · default showcase" : ""}</span><span class="lang-zh">{modern ? "评测" : "尝试"} {sampleLetter(runIndex)}{runIndex === 0 ? " · 默认展示" : ""}</span></span>
                      <span>{run.score ? run.score.percent.toFixed(1) : "—"}</span>
                      {modern ? <a href={`#evaluation-${run.run_id}`}>Evidence</a> : playable ? <a href={`/showcase/${playable.artifact_id.slice(7)}`}>Play</a> : <span class="muted">Build failed</span>}
                      {source && <a href={source.url}>Source</a>}
                    </div>
                  );
                })}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><span class="eyebrow">Game-by-game</span><h2>Where the points came from.</h2></div></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Game challenge</th><th>Type</th><th>{modern ? "Development / evaluations" : "Attempts"}</th><th>Score</th><th>Variation</th></tr></thead>
        <tbody>{publication.aggregate.tasks.map((task) => (
          <tr>
            <td><a href={`/benchmarks/${publication.benchmark.version}/games/${task.task_id}`}><span class="lang-en">{taskTitles(task.task_id).en}</span><span class="lang-zh">{taskTitles(task.task_id).zh}</span></a><div class="mono muted">{task.task_id}</div></td>
            <td>{task.track === "build" ? "Made new" : "Recreated"}</td>
            <td>{modern ? `${task.development_count} / ${task.evaluation_count}` : task.development_count}</td>
            <td class="score">{task.mean.toFixed(1)}</td><td>{task.standard_deviation.toFixed(1)}</td>
          </tr>
        ))}</tbody>
      </table></div>
    </section>

    <section class="section">
      <div class="section-head"><div><span class="eyebrow">What worked</span><h2>The score, split by capability.</h2></div><p>These point totals explain the main score. They are not another leaderboard.</p></div>
      <div class="grid cols-3">{[...categories.entries()].map(([name, category]) => (
        <div class="card metric"><strong>{category.earned.toFixed(1)}/{category.available.toFixed(1)}</strong><span>{humanize(name)}</span></div>
      ))}</div>
    </section>

    <section class="section">
      <div class="section-head"><div><span class="eyebrow">What went wrong</span><h2>Every failed check stays visible.</h2></div><p>{failedTests.length} failed browser check{failedTests.length === 1 ? "" : "s"} across the games above.</p></div>
      {failedTests.length === 0 ? <div class="callout">Every published browser check passed in the included runs.</div> : (
        <div class="table-wrap"><table>
          <thead><tr><th>Game</th><th>Check</th><th>Capability</th><th>Points lost</th><th>What happened</th></tr></thead>
          <tbody>{failedTests.map(({ run, test }) => (
            <tr>
              <td><span class="lang-en">{taskTitles(run.task_id).en}</span><span class="lang-zh">{taskTitles(run.task_id).zh}</span><div class="mono muted"><span class="lang-en">Sample {sampleFor(run)}</span><span class="lang-zh">样本 {sampleFor(run)}</span></div></td>
              <td>{humanize(test.id)}<div class="mono muted">{test.id}</div></td><td>{humanize(test.category)}</td><td>{test.points}</td><td>{test.message ?? "The expected behavior was not observed."}</td>
            </tr>
          ))}</tbody>
        </table></div>
      )}
    </section>

    {publication.review_summaries.length > 0 && (
      <section class="section prose"><details class="audit">
        <summary>Optional human-review summaries · {publication.review_summaries.length}</summary>
        <div class="audit-body"><p>These summaries are reported separately and never change the machine-contract score.</p>
          <div class="grid cols-3">{publication.review_summaries.map((review) => (
            <article class="card"><h3><span class="lang-en">{taskTitles(review.task_id).en}</span><span class="lang-zh">{taskTitles(review.task_id).zh}</span></h3>
              <p>{review.sample_count} samples · {review.outcomes.wins} wins · {review.outcomes.losses} losses · {review.outcomes.ties} ties · {review.outcomes.both_bad} both bad</p>
              <p class="mono">{Object.entries(review.tags).map(([tag, count]) => `${tag}:${count}`).join(" · ")}</p>
            </article>
          ))}</div>
        </div>
      </details></section>
    )}

    <section class="section prose identity">
      <div class="section-head"><div><span class="eyebrow">For auditors</span><h2>Exact runs, files, and identities.</h2></div><p>Most people can stop here. These records exist so researchers can reproduce and challenge the result.</p></div>
      <details class="audit">
        <summary>{modern ? "Development submissions, seed evaluations, timing, and verification" : "Historical attempts, timing, usage, and verification"}</summary>
        <div class="audit-body table-wrap"><table>
          <thead><tr><th>{modern ? "Evaluation" : "Attempt"}</th><th>Task</th><th>{modern ? "Evaluation seed" : "Seed"}</th><th>Score</th><th>{modern ? "Development / evaluation" : "Exit"}</th><th>Evaluation time</th><th>{modern ? "Development usage · shown once" : "Tokens / cost"}</th><th>Verification</th></tr></thead>
          <tbody>{publication.runs.map((run) => (
            <tr id={`evaluation-${run.run_id}`}>
              <td class="mono" title={run.run_id}>{run.run_id.slice(0, 10)}…</td>
              <td><span class="lang-en">{taskTitles(run.task_id).en}</span><span class="lang-zh">{taskTitles(run.task_id).zh}</span>{!run.included && <div class="muted">excluded</div>}</td>
              <td class="mono">{run.seed}</td><td class="score">{run.score ? run.score.percent.toFixed(1) : "—"}</td>
              <td>{modern ? `${humanize(run.development_exit_reason)} / ${humanize(run.exit_reason)}` : humanize(run.exit_reason)}</td>
              <td>{run.wall_time_ms === undefined ? "Not reported" : `${(run.wall_time_ms / 1000).toFixed(1)}s`}</td>
              <td>{run.usage && (!modern || firstEvaluationIds.has(run.run_id)) ? (
                <>{run.usage.input_tokens ?? "?"} in / {run.usage.output_tokens ?? "?"} out<div class="muted">{run.usage.cost_usd === undefined ? "cost not reported" : `$${run.usage.cost_usd.toFixed(4)}`}</div></>
              ) : modern && !firstEvaluationIds.has(run.run_id) ? "same submission" : "Not reported"}</td>
              <td>{run.verification ? `${run.verification.status} · ${run.verification.network_attestation}` : "Unverified"}</td>
            </tr>
          ))}</tbody>
        </table></div>
      </details>

      <details class="audit">
        <summary>Published source, game builds, screenshots, and licenses</summary>
        <div class="audit-body table-wrap"><table>
          <thead><tr><th>Owner</th><th>Stage</th><th>Role</th><th>File</th><th>Bytes</th><th>Content ID</th></tr></thead>
          <tbody>{artifactRows.map(({ owner, kind, artifact }) => (
            <tr><td class="mono">{owner.slice(0, 10)}…</td><td>{kind}</td><td>{artifact.role}</td><td><a href={artifact.url}>{artifact.file_name}</a></td><td>{artifact.size_bytes}</td><td class="mono">{artifact.artifact_id.slice(0, 23)}…</td></tr>
          ))}</tbody>
        </table></div>
      </details>

      <details class="audit"><summary>Immutable IDs and model parameters</summary><div class="audit-body">
        <p><strong>Publication</strong><br /><code>{publication.publication_id}</code></p>
        <p><strong>Configuration</strong><br /><code>{publication.configuration.configuration_id}</code></p>
        <p><strong>Model parameters</strong><br /><code>{JSON.stringify(publication.configuration.agent.parameters)}</code></p>
        <p><strong>Series</strong><br /><code>{publication.series_id}</code></p>
        <p><strong>Release lock</strong><br /><code>{publication.benchmark.release_hash}</code></p>
        <p><strong>Source commit</strong><br /><code>{publication.benchmark.git_commit}</code></p>
        <p><strong>Evaluator image</strong><br /><code>{imageDigests.length > 0 ? imageDigests.join(", ") : "Not verified"}</code></p>
      </div></details>
    </section>
  </div>
</Layout>
