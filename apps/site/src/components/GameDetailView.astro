---
import {
  playableCandidatesForTask,
  isPublicationRecord,
  isFlatBuildRecord,
  score,
  type SiteResultRecord,
  type PublicationRecord,
  type ReleaseCatalog,
} from "../lib/data";
import {
  sampleIndexForRun,
  sampleLetter,
  sortRunsForPresentation,
} from "../lib/presentation";

interface Props {
  catalog: ReleaseCatalog;
  taskId: string;
  records: SiteResultRecord[];
}

const { catalog, taskId, records } = Astro.props;
const releasedTask = catalog.tasks.find((task) => task.id === taskId);
if (!releasedTask) {
  throw new Error(`release ${catalog.release.benchmark_version} has no task ${taskId}`);
}
const version = catalog.release.benchmark_version;
const source = releasedTask.source;
const candidates = playableCandidatesForTask(taskId, version, records);
const candidateByRun = new Map(
  candidates.map((candidate) => [candidate.run.run_id, candidate]),
);
const flatOutputs = records.filter(isFlatBuildRecord)
  .filter(({ entry }) => entry.benchmark_version === version)
  .flatMap((record) => record.result.tasks.filter((task) => task.task_id === taskId)
    .map((task) => ({ record, task })))
  .sort((left, right) => Number(right.record.entry.tier === "official") - Number(left.record.entry.tier === "official") ||
    right.record.entry.created_at.localeCompare(left.record.entry.created_at));
const outputRuns = records.filter(isPublicationRecord)
  .filter((record) => record.publication.benchmark.version === version)
  .flatMap((record) =>
    record.publication.submissions
      .filter((submission) => submission.included && submission.task_id === taskId)
      .flatMap((submission) => {
        const evaluations = sortRunsForPresentation(
          submission.evaluations.filter((evaluation) => evaluation.included),
        );
        const run = evaluations[0];
        return run
          ? [{
              record,
              submission,
              evaluations,
              run,
              candidate: candidateByRun.get(run.run_id),
            }]
          : [];
      }),
  )
  .sort(
    (left, right) =>
      Number(right.record.entry.tier === "official") -
        Number(left.record.entry.tier === "official") ||
      right.record.entry.created_at.localeCompare(left.record.entry.created_at) ||
      left.submission.agent_invocation_index - right.submission.agent_invocation_index,
  );
const categories = source
  ? [...new Set(source.manifest.tests.map((test) => test.category))]
  : [];
const title = source?.manifest.title.en ?? releasedTask.id;
const humanize = (value: string) => value
  .replace(/[-_.]+/g, " ")
  .replace(/\b\w/g, (letter) => letter.toUpperCase());
const sampleFor = (record: PublicationRecord, runId: string) => {
  const runs = record.publication.runs.filter(
    (run) => run.included && run.task_id === taskId,
  );
  return sampleLetter(Math.max(sampleIndexForRun(runs, runId), 0));
};
const scoreForSubmission = (record: PublicationRecord, submissionId: string) =>
  record.publication.aggregate.tasks.find(
    (task) =>
      task.task_id === taskId &&
      (task.submission_id === undefined || task.submission_id === submissionId),
  )?.mean;
---

<span class="eyebrow">
  {releasedTask.track === "build" ? "Make a new game" : "Recreate an open game"}
  {source ? ` · difficulty ${source.manifest.level}` : ""}
</span>
<h1>
  <span class="lang-en">{title}</span>
  <span class="lang-zh">{source?.manifest.title.zh ?? title}</span>
</h1>
<p class="lead">
  <span class="lang-en">
    This challenge asks a coding agent to deliver a game you can actually play.
    It is checked by {source?.manifest.tests.length ?? "a fixed set of"} browser
    tests, then published here with its score and source.
  </span>
  <span class="lang-zh">
    这个任务要求 AI 编程助手做出一款真正能玩的游戏。完成后会跑
    {" "}{source?.manifest.tests.length ?? "一组固定"} 项自动测试，并把分数和源码一起公开。
  </span>
</p>

<div class="grid cols-4 section">
  <div class="card metric">
    <strong>{releasedTask.version}</strong><span>challenge version</span>
  </div>
  <div class="card metric">
    <strong>{source?.manifest.tests.length ?? "—"}</strong><span>browser checks</span>
  </div>
  <div class="card metric">
    <strong>{source ? `${source.manifest.budget_seconds / 60}m` : "—"}</strong>
    <span>time allowed</span>
  </div>
  <div class="card metric">
    <strong>{outputRuns.length + flatOutputs.length}</strong><span>development observations published</span>
  </div>
</div>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">Generated outputs</span>
      <h2>Same challenge. Different model-made games.</h2>
    </div>
    <p>
      We never cherry-pick the highest score. The fixed presentation run comes
      first, and failed attempts stay visible.
    </p>
  </div>
  {outputRuns.length + flatOutputs.length === 0 ? (
    <div class="card empty">
      <strong>No published output for this release.</strong>
      <span class="muted">The frozen task contract remains available for audit.</span>
    </div>
  ) : (
    <div class="grid cols-3">
      {flatOutputs.map(({ record, task }) => (
        <article class="card output-card">
          <div class="cover placeholder"><span class="lang-en">No playable artifact published</span><span class="lang-zh">未公开试玩附件</span></div>
          <div class="output-meta"><span class={`pill ${record.entry.tier}`}>{record.entry.tier}</span><span class="pill">{task.evaluation.status}</span></div>
          <h3>{record.entry.agent.model}</h3>
          <p>{record.entry.agent.id} · {record.entry.agent.harness}<br />Score {score(task.evaluation.score?.percent)} · {humanize(task.agent.exit_reason)}</p>
          <p><span class="lang-en">One frozen delivery. A source hash is not a public download or playable.</span><span class="lang-zh">一次冻结交付。源码哈希不代表已公开下载或试玩。</span></p>
          <a class="button secondary" href={`/results/${record.entry.publication_id.slice(7)}`}>Result</a>
        </article>
      ))}
      {outputRuns.map(({ record, submission, evaluations, run, candidate }) => (
        <article class="card output-card">
          {candidate?.showcase ? (
            <img
              class="cover"
              src={candidate.showcase.url}
              alt={`${record.entry.agent.model} output for ${taskId}`}
              loading="lazy"
            />
          ) : (
            <div class="cover placeholder">
              {candidate ? "Playable game · cover unavailable" : "This attempt did not produce a game you can open"}
            </div>
          )}
          <div class="output-meta">
            <span class={`pill ${record.entry.tier}`}>{record.entry.tier}</span>
            <span class="pill">{record.entry.status}</span>
            <span class="pill">
              {record.publication.schema_version === 2 ? (
                <>
                  <span class="lang-en">one submission · {evaluations.length} evaluations</span>
                  <span class="lang-zh">开发一次 · {evaluations.length} 次评测</span>
                </>
              ) : (
                <>
                  <span class="lang-en">Attempt {sampleFor(record, run.run_id)}</span>
                  <span class="lang-zh">尝试 {sampleFor(record, run.run_id)}</span>
                </>
              )}
            </span>
          </div>
          <h3>{record.entry.agent.model}</h3>
          <p>
            {record.entry.agent.id} · {record.entry.agent.harness}<br />
            Score {scoreForSubmission(record, submission.submission_id)?.toFixed(1) ?? "—"} · {humanize(submission.development_exit_reason)}
          </p>
          <div class="actions compact">
            {candidate && (
              <a
                class="button"
                href={`/showcase/${candidate.playable.artifact_id.slice(7)}`}
              >
                Play
              </a>
            )}
            {candidate?.source && (
              <a class="button secondary" href={candidate.source.url}>Source</a>
            )}
            <a
              class="button secondary"
              href={`/results/${record.entry.publication_id.slice(7)}`}
            >
              Result
            </a>
          </div>
        </article>
      ))}
    </div>
  )}
</section>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">Test contract</span>
      <h2>What the browser checks.</h2>
    </div>
    <div>{categories.map((category) => <span class="pill">{humanize(category)}</span>)}</div>
  </div>
  {source ? (
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Check</th><th>What it measures</th><th>Points</th><th>Test file</th></tr>
        </thead>
        <tbody>
          {source.manifest.tests.map((test) => (
            <tr>
              <td>{humanize(test.id)}<div class="mono muted">{test.id}</div></td>
              <td>{humanize(test.category)}</td>
              <td class="score">{test.points}</td>
              <td class="mono">{test.case}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="callout">
      This early release lock remains authoritative, but its complete task
      source is not present in this checkout. The lock identity is still shown
      below; no newer task source is substituted.
    </div>
  )}
</section>

<section class="section prose">
  <details class="audit">
    <summary>Technical challenge identity</summary>
    <div class="audit-body">
      {source && (
        <p>
          Tested at {source.manifest.runtime.viewport[0]} × {source.manifest.runtime.viewport[1]}
          {" "}with Node {source.manifest.runtime.node}, fixed-seed resets, controlled time,
          native input, and schema-validated state snapshots.
        </p>
      )}
      {source?.manifest.reference && (
        <p>
          Reference: <a href={source.manifest.reference.repository}>{source.manifest.reference.project}</a>
          {" "}at commit <code>{source.manifest.reference.commit}</code>, license {source.manifest.reference.license}.
        </p>
      )}
      <p><strong>Task ID</strong><br /><code>{releasedTask.id}</code></p>
      <p><strong>Task content</strong><br /><code>{releasedTask.hash}</code></p>
      <p><a href={`/releases/${version}`}>Open the v{version} release contract</a></p>
    </div>
  </details>
</section>
