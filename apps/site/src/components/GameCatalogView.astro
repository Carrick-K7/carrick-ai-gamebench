---
import {
  playableCandidatesForTask,
  type PublicationRecord,
  type ReleaseCatalog,
} from "../lib/data";

interface Props {
  catalog: ReleaseCatalog;
  records: PublicationRecord[];
}

const { catalog, records } = Astro.props;
const version = catalog.release.benchmark_version;
---

<div class="grid cols-3">
  {catalog.tasks.map((task, index) => {
    const outputs = playableCandidatesForTask(task.id, version, records);
    return (
      <article class="card game-card" data-ghost={String(index + 1).padStart(2, "0")}>
        <span class="number">{String(index + 1).padStart(2, "0")}</span>
        <h3>
          <a href={`/benchmarks/${version}/games/${task.id}`}>
            <span class="lang-en">{task.source?.manifest.title.en ?? task.id}</span>
            <span class="lang-zh">{task.source?.manifest.title.zh ?? task.id}</span>
          </a>
        </h3>
        <p>
          <span class="lang-en">
            {task.track === "build"
              ? "Build a complete game from a precise playable brief."
              : "Recreate the behavior and look of an existing open game."}
          </span>
          <span class="lang-zh">
            {task.track === "build"
              ? "按明确的需求，从零做出一款完整可玩的游戏。"
              : "参考现有开源游戏，还原它的玩法和外观。"}
          </span>
        </p>
        <div class="game-meta">
          <span class="pill">{task.track === "build" ? "make new" : "recreate"}</span>
          {task.source && <span class="pill">difficulty {task.source.manifest.level}</span>}
          <span class={`pill ${outputs.length > 0 ? "official" : ""}`}>
            {outputs.length} playable build{outputs.length === 1 ? "" : "s"}
          </span>
        </div>
      </article>
    );
  })}
</div>
