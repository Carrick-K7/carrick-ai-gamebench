---
import { translateToZh } from "../lib/translations";
import UiIcon from "../components/UiIcon.astro";
import { brandName, brandTagline, brandTaglineZh, githubUrl } from "../lib/brand";

interface Props {
  title: string;
  titleZh?: string;
  description?: string;
  descriptionZh?: string;
  canonicalPath?: string;
}

const {
  title,
  titleZh = translateToZh(title),
  description = "GameBench is a game-driven benchmark for coding agents.",
  descriptionZh = translateToZh(description),
  canonicalPath,
} = Astro.props;
const isHome = title === "GameBench" || title === brandName;
const pageTitle = isHome ? brandName : `${title} · ${brandName}`;
const pageTitleZh = isHome ? brandName : `${titleZh} · ${brandName}`;
const canonicalPathname = canonicalPath ?? Astro.url.pathname;
const canonical = Astro.site
  ? new URL(canonicalPathname, Astro.site)
  : new URL(canonicalPathname, Astro.url);
const socialImage = new URL("/og.png", canonical);
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} data-content-en={description} data-content-zh={descriptionZh} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={pageTitle} data-content-en={pageTitle} data-content-zh={pageTitleZh} />
    <meta property="og:description" content={description} data-content-en={description} data-content-zh={descriptionZh} />
    <meta property="og:locale" content="en_US" data-content-en="en_US" data-content-zh="zh_CN" />
    <meta property="og:locale:alternate" content="zh_CN" data-content-en="zh_CN" data-content-zh="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} data-content-en={pageTitle} data-content-zh={pageTitleZh} />
    <meta name="twitter:description" content={description} data-content-en={description} data-content-zh={descriptionZh} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title data-title-en={pageTitle} data-title-zh={pageTitleZh}>{pageTitle}</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("gamebench.theme") === "arcade" ? "arcade" : "arena";
      } catch {
        document.documentElement.dataset.theme = "arena";
      }
      try {
        const requested = new URLSearchParams(location.search).get("lang");
        const stored = localStorage.getItem("gamebench.language");
        const language = requested === "zh" || requested === "en"
          ? requested
          : stored === "zh" || stored === "en"
            ? stored
            : navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en";
        if (requested === "zh" || requested === "en") {
          localStorage.setItem("gamebench.language", requested);
        }
        document.documentElement.lang = language === "zh" ? "zh-CN" : "en";
        document.documentElement.dataset.language = language;
      } catch {
        document.documentElement.dataset.language = "en";
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label={brandName}>
        <span class="brand-mark" aria-hidden="true"><img src="/carrick-logo.svg" alt="" /></span>
        <span class="brand-copy">
          <strong><span class="brand-prefix">Carrick AI </span>GameBench</strong>
          <small><span class="lang-en">{brandTagline}</span><span class="lang-zh">{brandTaglineZh}</span></small>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/games"><span class="lang-en">Play games</span><span class="lang-zh">玩游戏</span></a>
        <a href="/leaderboard"><span class="lang-en">Rankings</span><span class="lang-zh">评测排行</span></a>
        <a href="/methodology"><span class="lang-en">Evaluation rules</span><span class="lang-zh">评测规则</span></a>
        <a href="/releases"><span class="lang-en">Benchmark releases</span><span class="lang-zh">测试集版本</span></a>
        <a class="nav-external" href={githubUrl} target="_blank" rel="noreferrer">
          <span class="lang-en">Source</span><span class="lang-zh">源码</span><UiIcon name="external" />
          <span class="visually-hidden">(opens in a new window)</span>
        </a>
      </nav>
      <div class="site-controls">
        <div class="mode-switch" role="group" aria-label="Visual style">
          <button type="button" data-set-theme="arena" aria-pressed="true">Arena</button>
          <button type="button" data-set-theme="arcade" aria-pressed="false">Pixel</button>
        </div>
        <button class="language-toggle" type="button" data-language-toggle aria-label="Switch to Chinese">
          中文
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div>
        <strong>{brandName}</strong>
        <span>Models make the games. Tests keep the score. You decide if they are fun.</span>
      </div>
      <div class="footer-links">
        <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href="/methodology">How scoring works</a>
        <span>Apache-2.0</span>
      </div>
    </footer>
    <div class="cursor-reticle" aria-hidden="true"></div>
    <script>
      import { translateToZh } from "../lib/translations";

      type Language = "en" | "zh";
      type Theme = "arena" | "arcade";
      const preferenceKey = "gamebench.language";
      const themeKey = "gamebench.theme";
      const originalText = new WeakMap<Text, string>();
      const originalAttributes = new WeakMap<Element, Map<string, string>>();

      function normalized(value: string): string {
        return value.trim().replace(/\s+/g, " ");
      }

      function selectedLanguage(): Language {
        const initialized = document.documentElement.dataset.language;
        if (initialized === "zh" || initialized === "en") return initialized;
        try {
          const stored = localStorage.getItem(preferenceKey);
          if (stored === "zh" || stored === "en") return stored;
        } catch {
          // Browser language remains a safe fallback when storage is unavailable.
        }
        return navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en";
      }

      function translateTextNode(node: Text, language: Language): void {
        const parent = node.parentElement;
        if (!parent || parent.closest("script, style")) return;
        const source = originalText.get(node) ?? node.textContent ?? "";
        originalText.set(node, source);
        const translated = language === "zh" ? translateToZh(normalized(source)) : source;
        if (language === "zh" && translated !== normalized(source)) {
          const leading = source.match(/^\s*/)?.[0] ?? "";
          const trailing = source.match(/\s*$/)?.[0] ?? "";
          node.textContent = `${leading}${translated}${trailing}`;
        } else {
          node.textContent = source;
        }
      }

      function translateAttributes(language: Language): void {
        const attributes = ["aria-label", "alt", "placeholder", "title"] as const;
        document.querySelectorAll<HTMLElement>("[aria-label], [alt], [placeholder], [title]").forEach((element) => {
          const originals = originalAttributes.get(element) ?? new Map<string, string>();
          for (const attribute of attributes) {
            const current = element.getAttribute(attribute);
            if (current === null) continue;
            if (!originals.has(attribute)) originals.set(attribute, current);
            const source = originals.get(attribute) ?? current;
            element.setAttribute(attribute, language === "zh" ? translateToZh(source) : source);
          }
          originalAttributes.set(element, originals);
        });
      }

      function applyLanguage(language: Language): void {
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);
        for (const node of nodes) translateTextNode(node, language);
        translateAttributes(language);

        document.documentElement.lang = language === "zh" ? "zh-CN" : "en";
        document.documentElement.dataset.language = language;
        const title = document.querySelector<HTMLTitleElement>("title");
        if (title) {
          document.title = language === "zh"
            ? title.dataset.titleZh ?? title.dataset.titleEn ?? document.title
            : title.dataset.titleEn ?? document.title;
        }
        document.querySelectorAll<HTMLMetaElement>("meta[data-content-en]").forEach((meta) => {
          meta.content = language === "zh"
            ? meta.dataset.contentZh ?? meta.dataset.contentEn ?? meta.content
            : meta.dataset.contentEn ?? meta.content;
        });
        document
          .querySelector("nav")
          ?.setAttribute("aria-label", language === "zh" ? "主导航" : "Primary navigation");
        const toggle = document.querySelector<HTMLButtonElement>("[data-language-toggle]");
        if (toggle) {
          toggle.textContent = language === "zh" ? "EN" : "中文";
          toggle.setAttribute(
            "aria-label",
            language === "zh" ? "切换为英文" : "Switch to Chinese",
          );
        }
        document.documentElement.dataset.languageReady = "true";
      }

      applyLanguage(selectedLanguage());
      document.querySelector("[data-language-toggle]")?.addEventListener("click", () => {
        const next: Language =
          document.documentElement.lang === "zh-CN" ? "en" : "zh";
        try {
          localStorage.setItem(preferenceKey, next);
        } catch {
          // The toggle remains functional when storage is unavailable.
        }
        applyLanguage(next);
      });

      function applyTheme(theme: Theme): void {
        document.documentElement.dataset.theme = theme;
        document.querySelectorAll<HTMLButtonElement>("[data-set-theme]").forEach((button) => {
          const selected = button.dataset.setTheme === theme;
          button.setAttribute("aria-pressed", String(selected));
        });
      }

      const currentTheme: Theme =
        document.documentElement.dataset.theme === "arcade" ? "arcade" : "arena";
      applyTheme(currentTheme);
      document.querySelectorAll<HTMLButtonElement>("[data-set-theme]").forEach((button) => {
        button.addEventListener("click", () => {
          const theme: Theme = button.dataset.setTheme === "arcade" ? "arcade" : "arena";
          try {
            localStorage.setItem(themeKey, theme);
          } catch {
            // Theme switching remains available without persistent storage.
          }
          applyTheme(theme);
        });
      });

      const path = window.location.pathname;
      document.querySelectorAll<HTMLAnchorElement>(".topbar nav a").forEach((link) => {
        const href = link.getAttribute("href") ?? "";
        if (href !== "/" && path.startsWith(href)) link.dataset.active = "true";
      });

      const reticle = document.querySelector<HTMLElement>(".cursor-reticle");
      if (reticle && window.matchMedia("(pointer: fine)").matches) {
        window.addEventListener("pointermove", (event) => {
          reticle.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Oxanium";
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url("/fonts/Oxanium-Variable.ttf") format("truetype");
  }
  @font-face {
    font-family: "Silkscreen";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/Silkscreen-Regular.ttf") format("truetype");
  }
  @font-face {
    font-family: "Silkscreen";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/Silkscreen-Bold.ttf") format("truetype");
  }
  @font-face {
    font-family: "Smiley Sans";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/SmileySans-Oblique.woff2") format("woff2");
  }
  @font-face {
    font-family: "Fusion Pixel SC";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/FusionPixel-10px-Proportional-SC.woff2") format("woff2");
  }
  :root {
    color-scheme: light;
    --ink: #132321;
    --muted: #5c706d;
    --line: #c6d8d5;
    --paper: #f4f6f6;
    --panel: rgba(255, 255, 255, .8);
    --panel-solid: #ffffff;
    --accent: #278f87;
    --accent-soft: #d8f1ef;
    --hot: #ff6b9d;
    --lime: #5dddd4;
    --shadow: 0 18px 60px rgba(16, 63, 59, .12);
    --radius: 18px;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --display: "Oxanium", "Smiley Sans", "Arial Black", "Helvetica Neue", var(--sans);
    --game-ui: "Oxanium", "Smiley Sans", "Trebuchet MS", var(--sans);
    --pixel: "Silkscreen", "Fusion Pixel SC", var(--mono);
  }

  html[data-theme="arcade"] {
    color-scheme: dark;
    --ink: #eefaff;
    --muted: #9bb8cb;
    --line: rgba(0, 255, 255, .25);
    --paper: #04060f;
    --panel: rgba(8, 13, 28, .92);
    --panel-solid: #080d1c;
    --accent: #00ffff;
    --accent-soft: #0d2935;
    --hot: #ff00d4;
    --lime: #00ff88;
    --shadow: 8px 8px 0 #01030a;
    --radius: 2px;
    --display: var(--pixel);
    --game-ui: var(--pixel);
  }

  html[data-language="zh"] {
    --sans: "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); font-family: var(--sans); scroll-behavior: smooth; }
  body {
    background:
      radial-gradient(circle at 12% 4%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 28rem),
      radial-gradient(circle at 88% 24%, color-mix(in srgb, var(--hot) 10%, transparent), transparent 30rem),
      var(--paper);
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
  }
  html[data-theme="arena"] body::before {
    background-image:
      linear-gradient(color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 5%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    content: "";
    inset: 0;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
    pointer-events: none;
    position: fixed;
    z-index: -1;
  }
  html[data-theme="arcade"] body {
    background:
      radial-gradient(circle at 20% 0%, rgba(0, 255, 255, .16), transparent 34rem),
      radial-gradient(circle at 90% 35%, rgba(255, 0, 212, .15), transparent 30rem),
      #04060f;
    cursor: crosshair;
  }
  html[data-theme="arcade"] body::before {
    background: repeating-linear-gradient(0deg, rgba(255,255,255,.025) 0 1px, transparent 1px 4px);
    content: "";
    inset: 0;
    pointer-events: none;
    position: fixed;
    z-index: 100;
  }
  a { color: inherit; text-underline-offset: 3px; }
  a, button { cursor: pointer; }
  :focus-visible { outline: 3px solid var(--hot); outline-offset: 3px; }
  .topbar {
    align-items: center;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 28px;
    grid-template-columns: auto 1fr auto;
    padding: 14px clamp(18px, 4vw, 64px);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px) saturate(1.2);
  }
  .brand { align-items: center; display: flex; gap: 11px; text-decoration: none; }
  .brand-mark { display: inline-flex; height: 40px; width: 53px; }
  .brand-mark img { display: block; height: 100%; object-fit: contain; width: 100%; }
  html[data-theme="arcade"] .brand-mark { filter: drop-shadow(0 0 8px rgba(0, 255, 255, .38)); }
  .brand-copy { display: grid; gap: 1px; }
  .brand-copy strong { font-family: var(--game-ui); font-size: 17px; font-weight: 750; letter-spacing: -.025em; }
  .brand-copy small { color: var(--muted); font-family: var(--game-ui); font-size: 10px; font-weight: 620; letter-spacing: .01em; }
  nav { display: flex; gap: clamp(13px, 1.8vw, 26px); justify-content: center; }
  nav a { align-items: center; color: var(--muted); display: inline-flex; font-family: var(--game-ui); font-size: 13px; font-weight: 700; gap: 5px; letter-spacing: .01em; position: relative; text-decoration: none; }
  nav a::after { background: var(--hot); bottom: -8px; content: ""; height: 3px; left: 0; position: absolute; transform: scaleX(0); transform-origin: left; transition: transform .18s ease; width: 100%; }
  nav a:hover, nav a[data-active="true"] { color: var(--ink); }
  nav a:hover::after, nav a[data-active="true"]::after { transform: scaleX(1); }
  .nav-external .ui-icon { height: 13px; width: 13px; }
  .visually-hidden { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }
  .site-controls { align-items: center; display: flex; gap: 8px; }
  .mode-switch { background: color-mix(in srgb, var(--ink) 7%, transparent); border: 1px solid var(--line); border-radius: 999px; display: flex; padding: 3px; }
  .mode-switch button {
    background: transparent; border: 0; border-radius: 999px; color: var(--muted);
    font-family: var(--game-ui); font-size: 9px; font-weight: 700; letter-spacing: .04em; padding: 6px 8px; text-transform: uppercase;
  }
  .mode-switch button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  html[data-theme="arcade"] .mode-switch,
  html[data-theme="arcade"] .mode-switch button { border-radius: 0; }
  .language-toggle {
    background: #39c5bb; border: 1px solid #39c5bb; border-radius: 999px; color: #071c1a;
    flex: 0 0 auto; font-family: var(--game-ui); font-size: 11px; font-weight: 750; padding: 8px 10px;
  }
  html[data-theme="arcade"] .language-toggle { background: var(--accent); border-color: var(--accent); border-radius: 0; box-shadow: 3px 3px 0 var(--hot); color: #04060f; }
  .language-toggle:hover { filter: brightness(1.08); transform: translateY(-1px); }
  main { min-height: calc(100vh - 164px); }
  .container { margin: 0 auto; max-width: 1340px; padding: 64px clamp(18px, 5vw, 72px) 96px; }
  .eyebrow { align-items: center; color: var(--accent); display: inline-flex; font-family: var(--game-ui); font-size: 11px; font-weight: 750; gap: 8px; letter-spacing: .09em; text-transform: uppercase; }
  .eyebrow::before { color: var(--hot); content: "◆"; font-size: 8px; }
  h1, h2 { font-family: var(--display); text-wrap: balance; }
  h1 { font-size: clamp(42px, 6vw, 80px); font-weight: 780; letter-spacing: -.038em; line-height: 1.02; margin: 20px 0 26px; max-width: 1120px; text-transform: uppercase; }
  h2 { font-size: clamp(31px, 4.5vw, 62px); font-weight: 740; letter-spacing: -.032em; line-height: 1.08; margin: 0 0 17px; }
  h3 { font-family: var(--game-ui); font-size: 20px; font-weight: 700; letter-spacing: -.015em; margin: 0 0 10px; }
  html[data-language="zh"] h1,
  html[data-language="zh"] h2,
  html[data-language="zh"] h3 { letter-spacing: -.02em; text-transform: none; text-wrap: pretty; }
  html[data-language="zh"] h1 { line-height: 1.12; }
  html[data-language="zh"] h2 { line-height: 1.18; }
  html[data-language="zh"] .eyebrow,
  html[data-language="zh"] th { letter-spacing: .04em; }
  html[data-theme="arcade"] h1,
  html[data-theme="arcade"] h2 { letter-spacing: -.03em; line-height: 1.15; text-shadow: 4px 4px 0 rgba(255, 0, 212, .2); }
  html[data-language="zh"][data-theme="arcade"] h1,
  html[data-language="zh"][data-theme="arcade"] h2 { letter-spacing: -.025em; }
  p { color: var(--muted); line-height: 1.7; }
  .lead { font-size: clamp(18px, 2vw, 25px); line-height: 1.5; max-width: 820px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .button {
    align-items: center; background: var(--ink); border: 1px solid var(--ink); border-radius: 999px; color: var(--paper);
    display: inline-flex; font-family: var(--game-ui); font-size: 13px; font-weight: 720; gap: 8px; letter-spacing: .01em;
    justify-content: center; min-height: 44px; padding: 11px 18px; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .button.secondary { background: transparent; color: var(--ink); }
  .button:hover { background: var(--accent); border-color: var(--accent); box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 30%, transparent); color: white; transform: translateY(-2px); }
  html[data-theme="arcade"] .button { border-radius: 0; box-shadow: 5px 5px 0 var(--hot); text-transform: uppercase; }
  html[data-theme="arcade"] .button:hover { box-shadow: 2px 2px 0 var(--lime); transform: translate(3px, 3px); }
  .grid { display: grid; gap: 18px; }
  .grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card {
    backdrop-filter: blur(16px); background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 1px 0 rgba(255,255,255,.35) inset; padding: 24px; transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
  }
  .card:hover { border-color: var(--accent); box-shadow: var(--shadow); transform: translateY(-3px); }
  html[data-theme="arcade"] .card { box-shadow: 6px 6px 0 #01030a; }
  html[data-theme="arcade"] .card:hover { box-shadow: 6px 6px 0 var(--hot); transform: translate(-2px, -2px); }
  .card p:last-child { margin-bottom: 0; }
  .metric { overflow: hidden; position: relative; }
  .metric::after { background: var(--accent); content: ""; height: 4px; inset: auto 0 0; position: absolute; transform: scaleX(.22); transform-origin: left; transition: transform .2s ease; }
  .metric:hover::after { transform: scaleX(1); }
  .metric strong { display: block; font-family: var(--display); font-size: clamp(31px, 4vw, 48px); font-variant-numeric: tabular-nums; font-weight: 760; letter-spacing: -.035em; line-height: 1; }
  .metric span { color: var(--muted); display: block; font-size: 12px; margin-top: 8px; }
  .section { border-top: 1px solid var(--line); margin-top: 84px; padding-top: 54px; }
  .section-head { align-items: end; display: flex; justify-content: space-between; margin-bottom: 28px; gap: 28px; }
  .section-head p { margin: 0; max-width: 580px; }
  .pill {
    background: color-mix(in srgb, var(--ink) 7%, transparent); border: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
    border-radius: 999px; color: var(--muted); display: inline-flex; font-family: var(--game-ui); font-size: 10px;
    font-weight: 720; letter-spacing: .035em; padding: 6px 9px; text-transform: uppercase;
  }
  html[data-theme="arcade"] .pill { border-radius: 0; }
  .pill.official { background: var(--lime); border-color: var(--lime); color: #172006; }
  .pill.experimental { background: color-mix(in srgb, var(--hot) 14%, var(--panel-solid)); border-color: var(--hot); color: var(--hot); }
