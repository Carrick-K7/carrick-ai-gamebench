---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "GameBench is a game-driven benchmark for coding agents.",
} = Astro.props;
const pageTitle = title === "GameBench" ? title : `${title} · GameBench`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">G</span>
        <span>GameBench</span>
        <small>OPEN BENCHMARK</small>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/leaderboard">Leaderboard</a>
        <a href="/experimental">Experimental</a>
        <a href="/games">Games</a>
        <a href="/methodology">Methodology</a>
        <a href="/releases">Releases</a>
        <a href="/source">Source</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div>
        <strong>GameBench</strong>
        <span>Measure agents by the games they can actually build.</span>
      </div>
      <div class="footer-links">
        <a href="https://github.com/Carrick-K7/carrick-ai-gamebench">GitHub</a>
        <a href="/methodology">Methodology</a>
        <span>Apache-2.0</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #111815;
    --muted: #657069;
    --line: #dfe4df;
    --paper: #f8faf6;
    --panel: #ffffff;
    --green: #116e4b;
    --green-bright: #9bf2c8;
    --lime: #d9ff84;
    --orange: #ef7d3d;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); font-family: var(--sans); }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; }
  .topbar {
    align-items: center;
    background: rgba(248, 250, 246, 0.94);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
  }
  .brand { align-items: center; display: flex; font-weight: 760; gap: 10px; text-decoration: none; }
  .brand-mark {
    align-items: center; background: var(--ink); border-radius: 7px; color: var(--lime);
    display: inline-flex; font-family: var(--mono); height: 30px; justify-content: center; width: 30px;
  }
  .brand small { color: var(--muted); font-family: var(--mono); font-size: 9px; letter-spacing: .08em; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; }
  nav a { color: var(--muted); font-size: 14px; font-weight: 600; text-decoration: none; }
  nav a:hover { color: var(--green); }
  main { min-height: calc(100vh - 170px); }
  .container { margin: 0 auto; max-width: 1280px; padding: 56px clamp(20px, 5vw, 72px) 88px; }
  .eyebrow { color: var(--green); font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { font-size: clamp(42px, 7vw, 88px); letter-spacing: -.055em; line-height: .98; margin: 18px 0 24px; max-width: 1000px; }
  h2 { font-size: clamp(28px, 4vw, 48px); letter-spacing: -.04em; line-height: 1.05; margin: 0 0 16px; }
  h3 { font-size: 19px; margin: 0 0 10px; }
  p { color: var(--muted); line-height: 1.7; }
  .lead { font-size: clamp(18px, 2vw, 24px); max-width: 780px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .button {
    background: var(--ink); border: 1px solid var(--ink); border-radius: 7px; color: white;
    cursor: pointer; display: inline-flex; font: inherit; font-size: 14px; font-weight: 700;
    padding: 12px 17px; text-decoration: none;
  }
  .button.secondary { background: transparent; color: var(--ink); }
  .button:hover { background: var(--green); border-color: var(--green); color: white; }
  .grid { display: grid; gap: 16px; }
  .grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 24px; }
  .card p:last-child { margin-bottom: 0; }
  .metric strong { display: block; font-family: var(--mono); font-size: 34px; letter-spacing: -.05em; }
  .metric span { color: var(--muted); font-size: 13px; }
  .section { border-top: 1px solid var(--line); margin-top: 72px; padding-top: 48px; }
  .section-head { align-items: end; display: flex; justify-content: space-between; margin-bottom: 24px; gap: 20px; }
  .section-head p { margin: 0; max-width: 580px; }
  .pill {
    background: #eef1ed; border-radius: 999px; color: #465149; display: inline-flex;
    font-family: var(--mono); font-size: 11px; font-weight: 700; padding: 6px 9px; text-transform: uppercase;
  }
  .pill.official { background: var(--green-bright); color: #064c32; }
  .pill.experimental { background: #fff0e5; color: #97451c; }
  table { border-collapse: collapse; width: 100%; }
  th { color: var(--muted); font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-align: left; text-transform: uppercase; }
  th, td { border-bottom: 1px solid var(--line); padding: 15px 12px; }
  td { font-size: 14px; }
  td.score { font-family: var(--mono); font-size: 18px; font-weight: 800; }
  .table-wrap { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow-x: auto; }
  .empty { padding: 64px 24px; text-align: center; }
  .empty strong { display: block; font-size: 20px; margin-bottom: 8px; }
  .mono { font-family: var(--mono); }
  .muted { color: var(--muted); }
  .game-card { min-height: 220px; position: relative; }
  .game-card .number { color: #cbd2cc; font-family: var(--mono); font-size: 12px; }
  .game-card a { text-decoration: none; }
  .game-card a::after { content: ""; inset: 0; position: absolute; }
  .game-card h3 { font-size: 25px; letter-spacing: -.035em; margin-top: 32px; }
  .game-meta { bottom: 22px; display: flex; gap: 8px; left: 24px; position: absolute; }
  .prose { max-width: 820px; }
  .prose h2 { font-size: 32px; margin-top: 52px; }
  .prose h3 { margin-top: 30px; }
  .prose li { color: var(--muted); line-height: 1.7; margin: 7px 0; }
  code { background: #edf0eb; border-radius: 4px; font-family: var(--mono); font-size: .9em; padding: 2px 5px; }
  .callout { background: #eff9f2; border-left: 4px solid var(--green); padding: 18px 22px; }
  .status-banner { margin-bottom: 32px; }
  iframe.game { aspect-ratio: 16 / 9; background: #0b0f0d; border: 0; border-radius: 10px; width: 100%; }
  .output-card { overflow: hidden; }
  .output-card .cover {
    aspect-ratio: 16 / 9; border: 1px solid var(--line); border-radius: 7px;
    display: block; margin: -8px -8px 20px; object-fit: cover; width: calc(100% + 16px);
  }
  .cover.placeholder, .player-cover.placeholder {
    align-items: center; background: #edf0eb; color: var(--muted); display: flex;
    font-family: var(--mono); font-size: 12px; justify-content: center; padding: 24px; text-align: center;
  }
  .output-meta { align-items: center; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .actions.compact { gap: 8px; margin-top: 18px; }
  .actions.compact .button { padding: 8px 11px; }
  .seed-list { border-top: 1px solid var(--line); margin-top: 18px; }
  .seed-row {
    align-items: center; border-bottom: 1px solid var(--line); display: grid;
    font-size: 12px; gap: 8px; grid-template-columns: 1.4fr .5fr .5fr .6fr; padding: 10px 0;
  }
  .player-shell {
    aspect-ratio: 16 / 9; background: #0b0f0d; border-radius: 10px; color: white;
    display: grid; overflow: hidden; place-items: center; position: relative;
  }
  .player-cover { height: 100%; inset: 0; object-fit: cover; opacity: .35; position: absolute; width: 100%; }
  .player-placeholder {
    align-items: center; display: flex; flex-direction: column; max-width: 520px;
    padding: 24px; position: relative; text-align: center; z-index: 1;
  }
  .player-placeholder strong { font-size: 22px; }
  .player-placeholder span { color: #cbd2cc; line-height: 1.6; margin: 10px 0 20px; }
  .player-shell iframe.game { height: 100%; position: absolute; width: 100%; }
  pre { background: #edf0eb; border-radius: 8px; overflow-x: auto; padding: 18px; }
  pre code { background: transparent; padding: 0; }
  .identity code { overflow-wrap: anywhere; }
  footer {
    border-top: 1px solid var(--line); color: var(--muted); display: flex; font-size: 13px;
    justify-content: space-between; padding: 28px clamp(20px, 5vw, 72px); gap: 24px;
  }
  footer strong { color: var(--ink); margin-right: 12px; }
  .footer-links { display: flex; gap: 20px; }
  @media (max-width: 900px) {
    .topbar { align-items: flex-start; gap: 16px; }
    nav { gap: 12px 18px; justify-content: flex-end; }
    .brand small { display: none; }
    .grid.cols-3, .grid.cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .topbar { position: static; }
    nav { display: none; }
    .grid.cols-3, .grid.cols-4 { grid-template-columns: 1fr; }
    .section-head, footer { align-items: flex-start; flex-direction: column; }
    h1 { font-size: 46px; }
  }
</style>
