{
  "name": "@carrick/gamebench",
  "version": "0.1.0",
  "description": "CLI and browser evaluator for Carrick AI GameBench.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "cagb": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @carrick/gamebench-core build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @carrick/gamebench-core build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@carrick/gamebench-core": "workspace:*",
    "@playwright/test": "1.61.1",
    "ajv": "8.18.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
