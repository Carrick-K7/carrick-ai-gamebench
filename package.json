{
  "name": "carrick-ai-gamebench",
  "version": "0.7.0",
  "private": true,
  "description": "Separate benchmarks for AI systems building and playing web games.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:static-security": "node tools/check-static-security.mjs",
    "smoke:templates": "node tools/smoke-templates.mjs",
    "calibrate:poker": "node tools/calibrate-poker.mjs",
    "test:play": "node --test benchmark/play/tests/*.test.mjs benchmark/play/calibration/*.test.mjs tools/agents/pi-play.test.mjs",
    "calibrate:play": "node tools/calibrate-play.mjs",
    "check": "pnpm check:boundaries && pnpm check:static-security && pnpm typecheck && pnpm test && pnpm build && pnpm cagb check && pnpm smoke:templates && pnpm calibrate:poker && pnpm test:play && pnpm calibrate:play",
    "cagb": "node packages/evaluator/dist/cli.js",
    "clean": "pnpm -r clean"
  }
}
