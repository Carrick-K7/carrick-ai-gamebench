{
  "name": "carrick-ai-gamebench",
  "version": "0.1.0",
  "private": true,
  "description": "A benchmark for coding agents building playable web games.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke:templates": "node tools/smoke-templates.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm cagb validate-task --all && pnpm cagb release-lock && pnpm smoke:templates",
    "cagb": "node packages/evaluator/dist/cli.js",
    "review": "pnpm --filter @carrick/gamebench-reviewer dev",
    "docker:build": "docker build -f docker/evaluator.Dockerfile -t carrick-ai-gamebench:local .",
    "clean": "pnpm -r clean"
  }
}
